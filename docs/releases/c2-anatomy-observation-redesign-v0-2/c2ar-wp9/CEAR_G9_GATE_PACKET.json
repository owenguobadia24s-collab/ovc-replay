  "acceptance_conditions": [
    {"id": "G9-A1", "condition": "Availability, computability, assurance, consumer eligibility and authority are separate dimensions and none implies another.", "required": true},
    {"id": "G9-A2", "condition": "Computability and eligibility are recorded per component, profile, observation or unit and exact consumer rather than as one global degraded state.", "required": true},
    {"id": "G9-A3", "condition": "Dependency graphs are versioned, profile-specific and limited to required, optional, warning-only, alternative and prohibited edges with no hidden fallback.", "required": true},
    {"id": "G9-A4", "condition": "Dependency failure propagates only to exact declared dependents and all propagated reason and dependency IDs remain visible.", "required": true},
    {"id": "G9-A5", "condition": "Not requested, not applicable, not computable, censored and conflicted remain distinct terminal dispositions with exact reason codes.", "required": true},
    {"id": "G9-A6", "condition": "Location profiles, raw and normalized motion, organisation metrics, interaction tracks and parent-dependent profiles retain separate dependency and usability results.", "required": true},
    {"id": "G9-A7", "condition": "Consumer eligibility is consumer-specific, requires computability and lawful authority, records assurance requirements and performs no silent exclusion.", "required": true},
    {"id": "G9-A8", "condition": "Staleness is consumer-specific and linked to raw age evidence while no universal or numeric threshold is selected at CEAR-G9.", "required": true},
    {"id": "G9-A9", "condition": "Every rate exposes registered scope, compatible unit, requested, applicable, computable, censored, conflicted, eligible, included, numerator and denominator counts with accounting identities.", "required": true},
    {"id": "G9-A10", "condition": "Transition rates use comparable transition pairs and raw counts remain separate from rates.", "required": true},
    {"id": "G9-A11", "condition": "Overlap is claim-specific, raw units are preserved and any adjusted claim requires exact cluster membership and one shared cluster policy ID without selecting a canonical adjustment.", "required": true},
    {"id": "G9-A12", "condition": "Comparisons fail closed as not comparable when unit, scope, release, clock, dependency, consumer, denominator, overlap or censorship policy differs.", "required": true},
    {"id": "G9-A13", "condition": "Global QUALITY cannot govern eligibility or denominator inclusion and cannot hide component status or reasons.", "required": true},
    {"id": "G9-A14", "condition": "Active C2, semantic or episode authority, rules, publication, Validation and probability, risk, exposure or execution remain unchanged.", "required": true}
