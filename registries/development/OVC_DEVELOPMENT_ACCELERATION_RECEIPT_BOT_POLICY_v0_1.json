    "RELEASE_PUBLICATION",
    "SELECTOR_MUTATION",
    "VALIDATION_ACCESS",
    "MARKET_OR_SEMANTIC_MUTATION",
    "PROBABILITY_RISK_EXPOSURE_OR_EXECUTION_OBJECT"
