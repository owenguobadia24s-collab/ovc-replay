  "required_activation_conditions": [
    "OPERATOR_DA_G4_PASS",
    "CLOSED_ACTIVE_PROFILE_SCHEMA_MATCH",
    "BRANCH_AND_PATH_ENFORCING_WRITER_ADAPTER",
    "NO_MERGE_API_AVAILABLE_TO_BOT",
    "DENIED_ACTION_TESTS_PASS",
    "TOKEN_REDACTION_TESTS_PASS",
    "IDEMPOTENCY_AND_COLLISION_TESTS_PASS",
    "REVOCATION_TESTS_PASS",
    "MAIN_BRANCH_PROTECTION_NO_BOT_BYPASS_VERIFIED",
