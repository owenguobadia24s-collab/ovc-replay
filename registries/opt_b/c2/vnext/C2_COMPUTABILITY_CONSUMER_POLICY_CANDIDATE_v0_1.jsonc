    "raw_counts_separate_from_rates": true,
    "rate_formula_fields_required": ["numerator_definition", "denominator_definition", "unit_type", "scope_id", "consumer_policy_id", "overlap_policy_id", "censor_conflict_treatment"],
    "silent_missingness_exclusion": false,
    "mixed_unit_rate": false
  },
  "overlap_contract": {
    "overlap_is_claim_specific": true,
