    "comparison_rule": "CLUSTER_ADJUSTED_RATES_MAY_BE_COMPARED_ONLY_WHEN_THE_SAME_CLUSTER_POLICY_ID_UNIT_AND_CLAIM_DEFINITION_ARE_USED",
    "raw_and_adjusted_rate_mixing": false,
    "generic_overlap_correction": false
