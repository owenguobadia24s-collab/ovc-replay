{
  "schema": "ovc-c2ar-computability-consumer-policy-candidate/v1",
  "programme_id": "OVC-C2-ANATOMY-REDESIGN-v0.2",
  "plan_id": "OVC-C2-ANATOMY-REDESIGN-IMPLEMENTATION",
  "plan_version": "0.2-REVISED",
  "packet_id": "C2AR-WP9",
  "gate_id": "CEAR-G9",
  "candidate_id": "C2AR.COMPUTABILITY.CONSUMER.POLICY.CANDIDATE.v1",
  "status": "PROPOSED_OPERATOR_GATE",
  "effective": false,
  "active": false,
  "canonical": false,
  "implementation_authority": "DENIED_PENDING_CEAR_G9",
  "authority": "CANDIDATE_ONLY_NO_RUNTIME_EFFECT",
  "central_decision": "USABILITY_IS_PER_COMPONENT_AND_PER_CONSUMER_WITH_EXPLICIT_DEPENDENCIES_DENOMINATORS_AND_OVERLAP_EVIDENCE_NOT_ONE_GLOBAL_DEGRADED_OR_QUALITY_STATE",
  "separate_dimensions": [
    {
      "dimension": "AVAILABILITY",
      "statuses": ["AVAILABLE", "UNAVAILABLE", "NOT_REQUESTED"],
      "meaning": "Whether the exact source object or measurement exists and was requested; availability alone does not imply computability."
    },
    {
      "dimension": "COMPUTABILITY",
      "statuses": ["COMPUTABLE", "PARTIALLY_COMPUTABLE", "NOT_COMPUTABLE", "NOT_APPLICABLE", "CENSORED", "CONFLICTED"],
      "meaning": "Whether the declared component can be deterministically produced under its exact dependency graph; partial status is allowed only for explicitly named subcomponents."
    },
    {
      "dimension": "ASSURANCE",
      "statuses": ["ASSURED", "UNASSURED", "CONFLICTED", "NOT_ASSESSED"],
      "meaning": "Whether the produced evidence passed its declared assurance checks; assurance does not grant consumer eligibility or authority."
    },
    {
      "dimension": "CONSUMER_ELIGIBILITY",
      "statuses": ["ELIGIBLE", "INELIGIBLE", "NOT_EVALUATED"],
      "meaning": "Whether one exact consumer policy accepts the component; the same component may be eligible for one consumer and ineligible for another."
    },
    {
      "dimension": "AUTHORITY",
      "statuses": ["AUTHORIZED", "UNAUTHORIZED"],
      "meaning": "Whether the consumer is lawfully allowed to use the evidence; code, computability, assurance or eligibility never grants authority."
    }
  ],
  "terminal_dispositions": [
    "NOT_REQUESTED",
    "NOT_APPLICABLE",
    "COMPUTABLE",
    "NOT_COMPUTABLE",
    "CENSORED",
    "CONFLICTED"
  ],
  "reason_code_families": {
    "request_and_applicability": ["NOT_REQUESTED", "NOT_APPLICABLE", "CONSUMER_NOT_REGISTERED"],
    "warmup_and_population": ["WARMUP_INSUFFICIENT", "POPULATION_INSUFFICIENT", "COMPARABLE_PAIR_UNAVAILABLE"],
    "source_and_continuity": ["SOURCE_MISSING", "SOURCE_INCOMPLETE", "CONTINUITY_GAP", "CLOCK_SLOT_MISSING", "IDENTITY_MISMATCH"],
    "censorship": ["LEFT_CENSORED", "RIGHT_CENSORED", "BOUNDARY_CENSORED", "SOURCE_CENSORED"],
    "ambiguity": ["AMBIGUOUS_IDENTITY", "MULTIPLE_ELIGIBLE_NO_GOVERNED_SELECTION", "REFERENCE_UNRESOLVED"],
    "staleness": ["STALE_FOR_CONSUMER", "STALENESS_POLICY_UNAVAILABLE", "AGE_EVIDENCE_UNAVAILABLE"],
    "model_and_dependency": ["MODEL_UNAVAILABLE", "DEPENDENCY_NOT_COMPUTABLE", "ALTERNATIVE_GROUP_UNSATISFIED", "PROHIBITED_DEPENDENCY_PRESENT"],
    "conflict": ["SOURCE_CONFLICT", "DEFINITION_CONFLICT", "ASSURANCE_CONFLICT", "POLICY_CONFLICT"],
    "authority": ["CONSUMER_UNAUTHORIZED", "VALIDATION_LOCKED", "PUBLICATION_DENIED", "SEMANTIC_AUTHORITY_DENIED"]
  },
  "dependency_graph": {
    "versioned": true,
    "profile_specific": true,
    "edge_types": ["REQUIRED", "OPTIONAL", "WARNING_ONLY", "ALTERNATIVE", "PROHIBITED"],
    "required_edge_failure": "PROPAGATE_ONLY_TO_THE_DECLARED_DEPENDENT_COMPONENT",
    "optional_edge_failure": "RETAIN_COMPONENT_COMPUTABILITY_AND_RECORD_WARNING",
    "warning_only_edge_failure": "NO_COMPUTABILITY_EFFECT_RECORD_WARNING_ONLY",
    "alternative_edge_rule": "AT_LEAST_ONE_MEMBER_OF_THE_EXACT_NAMED_GROUP_MUST_BE_COMPUTABLE",
    "prohibited_edge_rule": "PRESENCE_FAILS_CLOSED_WITH_PROHIBITED_DEPENDENCY_PRESENT",
    "hidden_fallback": false,
    "dependency_ids_required": true,
    "reason_propagation_required": true,
    "global_failure_propagation": false
  },
  "axis_and_profile_rules": [
    {
      "axis": "LOCATION",
      "rule": "LOCAL_TRAILING_LOCAL_STRUCTURAL_PARENT_MEASUREMENT_AND_PARENT_STRUCTURAL_PROFILES_HAVE_SEPARATE_DEPENDENCY_GRAPHS_AND_USABILITY_RESULTS"
    },
    {
      "axis": "MOTION",
      "rule": "RAW_MOTION_REQUIRES_DECLARED_SEQUENCE_AND_CONTINUITY_ONLY_WHILE_NORMALIZED_MOTION_ADDITIONALLY_REQUIRES_ONE_EXACT_NAMED_SCALE"
    },
    {
      "axis": "ORGANISATION",
      "rule": "EACH_METRIC_IS_INDEPENDENTLY_COMPUTABLE_AND_PARTIAL_AXIS_OUTPUT_MUST_EXPOSE_EVERY_AVAILABLE_AND_UNAVAILABLE_METRIC"
    },
    {
      "axis": "INTERACTION",
      "rule": "COMPUTABILITY_IS_PER_EXACT_OBJECT_ID_AND_TRACK_AND_NEVER_INFERRED_FROM_ANOTHER_OBJECT_OR_NEARBY_TRACK"
    },
    {
      "axis": "QUALITY_COMPATIBILITY_PROJECTION",
      "rule": "GLOBAL_QUALITY_IS_RETIRED_AS_A_GOVERNING_STATE_AND_MAY_EXIST_ONLY_AS_A_TRANSPARENT_NON_GOVERNING_COMPATIBILITY_PROJECTION"
    },
    {
      "axis": "PARENT_DEPENDENT_PROFILES",
      "rule": "MISSING_OR_NOT_COMPUTABLE_PARENT_CONTEXT_AFFECTS_ONLY_PROFILES_WITH_A_REQUIRED_PARENT_DEPENDENCY"
    }
  ],
  "consumer_policy": {
    "consumer_policy_id_required": true,
    "consumer_identity_required": true,
    "dependency_graph_id_required": true,
    "eligibility_result_per_component": true,
    "eligibility_requires_computable": true,
    "eligibility_requires_authorized": true,
    "assurance_requirement_declared_by_consumer": true,
    "staleness_policy_id_required_when_age_is_used": true,
    "universal_staleness_policy": false,
    "numeric_staleness_threshold_selected": false,
    "consumer_specific_numeric_parameters": "NOT_GRANTED_AT_CEAR_G9",
    "silent_exclusion": false,
    "hidden_fallback": false
  },
  "denominator_contract": {
    "registered_scope_id_required": true,
    "consumer_policy_id_required": true,
    "unit_type_required": true,
    "supported_unit_types": ["OBSERVATION", "TRANSITION_PAIR", "OBJECT_TRACK", "WINDOW", "BUNDLE", "RELATION", "DETECTOR_OUTPUT"],
    "required_counts": [
      "population_count",
      "requested_count",
      "not_requested_count",
      "applicable_count",
