      "REQUESTED_COUNT_EQUALS_APPLICABLE_COUNT_PLUS_NOT_APPLICABLE_COUNT",
      "APPLICABLE_COUNT_EQUALS_COMPUTABLE_COUNT_PLUS_NOT_COMPUTABLE_COUNT_PLUS_CENSORED_COUNT_PLUS_CONFLICTED_COUNT",
      "ELIGIBLE_COUNT_LESS_THAN_OR_EQUAL_TO_COMPUTABLE_COUNT",
