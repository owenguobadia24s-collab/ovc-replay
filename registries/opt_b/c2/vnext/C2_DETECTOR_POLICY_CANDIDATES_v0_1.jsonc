{"schema":"ovc-c2-detector-policy-candidates/v1","registry_id":"C2AR.DETECTOR.POLICIES.CANDIDATE.v1","programme_id":"OVC-C2-ANATOMY-REDESIGN-v0.2","packet_id":"C2AR-WP7","gate_id":"CEAR-G7","status":"PROPOSED_OPERATOR_REVIEW","effective":false,"active_detector_id":null,"canonical_detector_id":null,"authority":"NONE_PENDING_OPERATOR_DECISION","policies":[{"detector_id":"C2.DETECTOR.FIXED_OBJECT_CROSSING.v1","purpose":"Emit directional crossing only for one unchanged immutable level/boundary identity using ordered M1 or tick path evidence.","required_inputs":["FIXED_OBJECT_ID","OBJECT_VALUE","ORDERED_PATH","PREVIOUS_TIME","CURRENT_TIME","SOURCE_PRECISION"],"outputs":["CROSS_UP","CROSS_DOWN","TOUCH_ONLY","NO_CROSS","INSUFFICIENT_ORDERED_PATH"],"ohlc_directional_authority":false,"numeric_thresholds":[],"active":false,"canonical":false,"semantic_authority":"NONE"},{"detector_id":"C2.DETECTOR.PRECISION_TOUCH.v1","purpose":"Emit a raw equality/touch fact when a point or span equals an immutable level or container boundary at declared source precision.","required_inputs":["PROBE_ID","OBJECT_ID","SOURCE_PRECISION","RAW_TOPOLOGY"],"outputs":["TOUCH","NO_TOUCH","NOT_COMPUTABLE"],"proximity_substitution":false,"numeric_thresholds":[],"active":false,"canonical":false,"semantic_authority":"NONE"},{"detector_id":"C2.DETECTOR.CONTAINER_ENTRY_EXIT.v1","purpose":"Emit raw entry or exit topology only when two chronological point relations reference the same immutable positive-width container.","required_inputs":["PREVIOUS_CONTAINER_RELATION","CURRENT_CONTAINER_RELATION","SAME_CONTAINER_ID"],"outputs":["ENTRY_FROM_BELOW","ENTRY_FROM_ABOVE","EXIT_TO_BELOW","EXIT_TO_ABOVE","REMAIN_INSIDE","REMAIN_OUTSIDE","BOUNDARY_ONLY","NOT_COMPUTABLE"],"acceptance_or_rejection_authority":false,"numeric_thresholds":[],"active":false,"canonical":false,"semantic_authority":"NONE"},{"detector_id":"C2.DETECTOR.RAW_DISTANCE_CHANGE.v1","purpose":"Emit contraction, expansion or unchanged absolute distance against the same immutable object without naming approach, test or retreat.","required_inputs":["RELATION_DELTA_ID","SAME_OBJECT_ID","ABSOLUTE_DISTANCE_DELTA"],"outputs":["DISTANCE_DECREASED","DISTANCE_INCREASED","DISTANCE_UNCHANGED","NOT_COMPUTABLE"],"approaching_label_authority":false,"numeric_thresholds":[],"active":false,"canonical":false,"semantic_authority":"NONE"},{"detector_id":"C2.DETECTOR.REFERENCE_IDENTITY_CHANGE.v1","purpose":"Emit explicit change of level, container, horizon or projection reference identity and state that it is not a crossing.","required_inputs":["PREVIOUS_REFERENCE_ID","CURRENT_REFERENCE_ID","FIRST_VALID_TIME"],"outputs":["REFERENCE_CHANGED","REFERENCE_UNCHANGED"],"crossing_authority":false,"numeric_thresholds":[],"active":false,"canonical":false,"semantic_authority":"NONE"},{"detector_id":"C2.DETECTOR.STRUCTURAL_GRAPH_CHANGE.v1","purpose":"Emit raw additions, removals or supersessions in frozen level/container/swing graph identities and edges.","required_inputs":["PREVIOUS_GRAPH_ID","CURRENT_GRAPH_ID","COMPLETE_INVENTORIES"],"outputs":["NODE_ADDED","NODE_SUPERSEDED","EDGE_ADDED","EDGE_REMOVED","DEPTH_CHANGED","NO_STRUCTURAL_CHANGE","NOT_COMPUTABLE"],"regime_authority":false,"numeric_thresholds":[],"active":false,"canonical":false,"semantic_authority":"NONE"}],"policy_contract":{"ordered_chronology_required":true,"same_object_required_where_applicable":true,"complete_input_inventory_required":true,"ambiguous_or_censored_input":"NOT_COMPUTABLE_NO_FALLBACK","multiple_detector_outputs_may_coexist":true,"detector_precedence":"NONE","event_or_episode_creation":"PROHIBITED","semantic_label_creation":"PROHIBITED"},"prohibited_outputs":["APPROACHING","TESTING","REJECTING","ACCEPTING","BREAKOUT","REVERSAL","CONTINUATION","SETUP","SIGNAL","EVENT_ID","EPISODE_ID","PROBABILITY","OUTCOME"],"proposed_authority_effect":"AUTHORISE_VERSIONED_SHADOW_FROZEN_RAW_DETECTOR_CONTRACTS_IMPLEMENTATIONS_FIXTURES_TESTS_AND_READ_ONLY_SHADOW_OUTPUTS_ONLY","explicit_non_effects":["NO_DETECTOR_ACTIVATION","NO_CANONICAL_DETECTOR","NO_NUMERIC_THRESHOLD_PARAMETER_OR_SCALE_SELECTION","NO_SEMANTIC_EVENT_OR_EPISODE_PROMOTION","NO_PARENT_RESOLVER_OR_DENOMINATOR_POLICY","NO_RULE_OR_THEORY_PROMOTION","NO_RELEASE_PUBLICATION_VALIDATION","NO_PROBABILITY_RISK_EXPOSURE_EXECUTION"],"rollback":"Before operator PASS remove or supersede this non-effective candidate. After PASS preserve detector IDs and supersede only through a new authorised version."}
