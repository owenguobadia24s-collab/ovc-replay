{"schema":"ovc-c2-transition-classification-candidate/v1","candidate_id":"C2AR.TRANSITION.CLASSIFICATION.CANDIDATE.v1","programme_id":"OVC-C2-ANATOMY-REDESIGN-v0.2","packet_id":"C2AR-WP7","gate_id":"CEAR-G7","status":"PROPOSED_OPERATOR_REVIEW","effective":false,"active":false,"canonical":false,"authority":"NONE_PENDING_OPERATOR_DECISION","freeze_prerequisite":"C2AR.INTEGRATED.SHADOW.FREEZE.v1","formula_registry_prerequisite":"C2AR.FORMULA.PROFILES.v1","transition_classes":[{"class_id":"NO_CHANGE","definition":"Previous and current records have identical category, measurements, object identities, computability and structural graph identities.","required_evidence":["PREVIOUS_OUTPUT_ID","CURRENT_OUTPUT_ID","CHRONOLOGY","SAME_PROFILE_VERSION"],"semantic_authority":"NONE"},{"class_id":"MEASUREMENT_CHANGE","definition":"One or more raw numeric measurements change while profile, category, referenced immutable objects and structural graph identities remain unchanged.","examples":["SIGNED_DISTANCE_DELTA","ABSOLUTE_DISTANCE_DELTA","PRICE_DELTA","WIDTH_OR_CENTRE_MEASUREMENT_CHANGE"],"semantic_authority":"NONE"},{"class_id":"CATEGORICAL_CHANGE","definition":"A frozen raw categorical field changes while the compared immutable object and profile identity remain the same.","examples":["BELOW_TO_EQUAL","OUTSIDE_TO_INSIDE","COMPUTABLE_TO_NOT_COMPUTABLE"],"semantic_authority":"NONE"},{"class_id":"STRUCTURAL_CHANGE","definition":"The level/container/swing graph inventory, edge set, structural depth or immutable structural object identity changes.","examples":["NEW_CONFIRMED_LEVEL","CONTAINER_SUPERSESSION","GRAPH_EDGE_CHANGE","STRUCTURAL_DEPTH_CHANGE"],"semantic_authority":"NONE"},{"class_id":"REFERENCE_IDENTITY_CHANGE","definition":"The referenced level, container, projection or horizon identity changes; this is not a crossing and cannot be inferred as interaction with either object.","examples":["PARENT_LINK_CHANGE","ROLE_PROJECTION_REFERENCE_CHANGE","HORIZON_ID_CHANGE"],"semantic_authority":"NONE"},{"class_id":"COMPUTABILITY_CHANGE","definition":"Evidence expectation, continuity, censorship, ambiguity, conflict or component computability changes, recorded independently of market-state semantics.","examples":["WARMUP_TO_AVAILABLE","AVAILABLE_TO_CENSORED","CONFLICT_FLAG_CHANGE"],"semantic_authority":"NONE"}],"classification_precedence":["STRUCTURAL_CHANGE","REFERENCE_IDENTITY_CHANGE","COMPUTABILITY_CHANGE","CATEGORICAL_CHANGE","MEASUREMENT_CHANGE","NO_CHANGE"],"precedence_rule":"Return every applicable class plus one primary class chosen by this fixed evidence-severity order; primary class carries no market meaning.","comparison_contract":{"same_profile_version_required":true,"previous_before_current_required":true,"same_declared_scope_required":true,"future_or_outcome_fields":"PROHIBITED","missing_input":"NOT_COMPUTABLE_NO_FALLBACK","cross_clock_equivalence":"PROHIBITED_UNLESS_EXPLICIT_MAPPING","object_identity_change_is_crossing":false},"prohibited_classes":["REVERSAL","CONTINUATION","BREAKOUT","REJECTION","ACCEPTANCE","REGIME_CHANGE","SETUP","SIGNAL","OUTCOME"],"proposed_authority_effect":"AUTHORISE_VERSIONED_SHADOW_FROZEN_TRANSITION_RECORDS_AND_DETERMINISTIC_CLASSIFIER_IMPLEMENTATION_ONLY","explicit_non_effects":["NO_ACTIVE_C2_MUTATION","NO_SEMANTIC_STATE_PROMOTION","NO_EVENT_OR_EPISODE_PROMOTION","NO_NUMERIC_THRESHOLD_SELECTION","NO_RULE_OR_THEORY_PROMOTION","NO_RELEASE_PUBLICATION_VALIDATION","NO_PROBABILITY_RISK_EXPOSURE_EXECUTION"],"rollback":"Before operator PASS remove or supersede this non-effective candidate. After PASS preserve class IDs and supersede only through a new authorised version."}
