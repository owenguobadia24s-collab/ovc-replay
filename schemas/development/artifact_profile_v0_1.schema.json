{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ovc.local/schemas/development/artifact_profile_v0_1.schema.json",
  "title": "OVC Artifact Profile v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profile_id", "programme_id", "packet_id", "authority", "inputs", "test_profile", "export_profile"],
  "properties": {
    "schema": {"const": "ovc-artifact-profile/v1"},
    "profile_id": {"type": "string", "minLength": 1},
    "programme_id": {"type": "string", "minLength": 1},
    "packet_id": {"type": "string", "minLength": 1},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_access", "release", "selector", "r2", "validation", "repository_bot_write", "direct_main_write", "force_push"],
      "properties": {
        "provider_access": {"const": "DENIED"},
        "release": {"const": "DENIED"},
        "selector": {"const": "DENIED"},
        "r2": {"const": "DENIED"},
        "validation": {"const": "DENIED"},
        "repository_bot_write": {"const": "DENIED"},
        "direct_main_write": {"const": "DENIED"},
        "force_push": {"const": "DENIED"}
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["logical_name", "relative_path", "identity_policy"],
        "properties": {
          "logical_name": {"type": "string", "minLength": 1},
          "relative_path": {"type": "string", "minLength": 1},
          "identity_policy": {"type": "string", "minLength": 1},
          "required": {"type": "boolean", "default": true}
        }
      }
    },
    "test_profile": {"type": "string", "minLength": 1},
    "export_profile": {"type": ["string", "null"]}
  }
}
