{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ovc.local/schemas/development/closure_proposal_v0_1.schema.json",
  "title": "OVC Closure Proposal v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "snapshot_id", "policy_id", "policy_hash", "programme_id", "packet_id",
    "gate_id", "pull_request", "base_branch", "baseline_commit", "head_branch", "head_sha",
    "changed_files", "status", "blockers", "proposed_merge_method", "exact_head_required",
    "eligible_for_manual_squash_merge", "next_packet", "authority", "closure_proposal_id"
  ],
  "properties": {
    "schema": {"const": "ovc-closure-proposal/v1"},
    "snapshot_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_id": {"type": "string", "minLength": 1},
    "policy_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "programme_id": {"type": "string", "minLength": 1},
    "packet_id": {"type": "string", "minLength": 1},
    "gate_id": {"type": "string", "minLength": 1},
    "pull_request": {"type": "integer", "minimum": 1},
    "base_branch": {"const": "main"},
    "baseline_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "head_branch": {"type": "string", "minLength": 1},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "changed_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "status": {"enum": ["PASS", "BLOCK"]},
    "blockers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "proposed_merge_method": {"const": "squash"},
    "exact_head_required": {"const": true},
    "eligible_for_manual_squash_merge": {"type": "boolean"},
    "next_packet": {"type": "string", "minLength": 1},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dry_run_only", "writes_performed", "merge_performed", "repository_bot_write", "direct_main_write", "force_push", "history_rewrite"],
      "properties": {
        "dry_run_only": {"const": true},
        "writes_performed": {"const": false},
        "merge_performed": {"const": false},
        "repository_bot_write": {"const": "DENIED"},
        "direct_main_write": {"const": "DENIED"},
        "force_push": {"const": "DENIED"},
        "history_rewrite": {"const": "DENIED"}
      }
    },
    "closure_proposal_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
