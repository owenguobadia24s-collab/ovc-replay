{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ovc.local/schemas/development/closure_snapshot_v0_1.schema.json",
  "title": "OVC Closure Snapshot v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "policy_id", "policy_hash", "plan_id", "plan_version", "programme_id",
    "packet_id", "gate_id", "pull_request", "base_branch", "baseline_commit", "head_branch",
    "head_sha", "changed_files", "required_checks", "qa_status", "decision", "decision_id",
    "authority_delta", "reserved_authority_delta", "blockers", "warnings",
    "unresolved_review_count", "rollback", "next_packet"
  ],
  "properties": {
    "schema": {"const": "ovc-closure-snapshot/v1"},
    "policy_id": {"type": "string", "minLength": 1},
    "policy_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan_id": {"type": "string", "minLength": 1},
    "plan_version": {"type": "string", "minLength": 1},
    "programme_id": {"type": "string", "minLength": 1},
    "packet_id": {"type": "string", "minLength": 1},
    "gate_id": {"type": "string", "minLength": 1},
    "pull_request": {"type": "integer", "minimum": 1},
    "base_branch": {"const": "main"},
    "baseline_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "head_branch": {"type": "string", "minLength": 1},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "changed_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "required_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "run_id", "result"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "run_id": {"type": "integer", "minimum": 1},
          "result": {"type": "string", "minLength": 1}
        }
      }
    },
    "qa_status": {"type": "string", "minLength": 1},
    "decision": {"type": "string", "minLength": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "authority_delta": {"type": "string", "minLength": 1},
    "reserved_authority_delta": {"type": "string", "minLength": 1},
    "blockers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "warnings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "unresolved_review_count": {"type": "integer", "minimum": 0},
    "rollback": {"type": "string", "minLength": 1},
    "next_packet": {"type": "string", "minLength": 1}
  }
}
