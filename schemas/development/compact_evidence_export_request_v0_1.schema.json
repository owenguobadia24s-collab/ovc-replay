{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ovc://schemas/development/compact_evidence_export_request_v0_1.schema.json",
  "title": "OVC compact evidence export request v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "export_id", "programme_id", "profile_id", "source_commit", "files"],
  "properties": {
    "schema": {"const": "ovc-compact-evidence-export-request/v1"},
    "export_id": {"type": "string", "pattern": "^DA-EXPORT-[A-Z0-9._-]+$"},
    "programme_id": {"const": "OVC-DEV-ACCEL-v0.1"},
    "profile_id": {"const": "OVC.DEVELOPMENT.ACCELERATION.COMPACT-EVIDENCE-EXPORT.v0.1"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size_bytes", "sha256", "role"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "role": {"type": "string", "enum": ["CONTRACT", "SCHEMA", "REGISTRY", "PACKET", "QA", "DECISION", "RECEIPT", "DOCUMENTATION"]}
        }
      }
    }
  }
}
