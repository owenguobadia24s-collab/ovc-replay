{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ovc://schemas/development/default_workflow_adoption_profile_v0_1.schema.json",
  "title": "OVC Development Acceleration default workflow adoption proposal v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile_id",
    "programme_id",
    "gate_id",
    "status",
    "active",
    "default_scope",
    "required_stages",
    "mandatory_acceleration_conditions",
    "retirement_mode",
    "retired_mechanics",
    "exceptions",
    "permanent_denials",
    "rollback"
  ],
  "properties": {
    "schema": {"const": "ovc-default-workflow-adoption-profile/v1"},
    "profile_id": {"const": "OVC.DEVELOPMENT.ACCELERATION.DEFAULT-WORKFLOW.v0.1"},
    "programme_id": {"const": "OVC-DEV-ACCEL-v0.1"},
    "gate_id": {"const": "DA-G6"},
    "status": {"const": "PENDING_OPERATOR_DA_G6"},
    "active": {"const": false},
    "default_scope": {"const": "FUTURE_ELIGIBLE_OVC_IMPLEMENTATION_PACKETS_WITH_APPROVED_REGISTERED_PROFILE"},
    "required_stages": {
      "const": [
        "AUTHORITY_AND_PREREQUISITE_RESOLUTION",
        "UNIVERSAL_ARTIFACT_PREFLIGHT",
        "DETERMINISTIC_IMPLEMENTATION",
        "TIERED_TEST_SELECTION",
        "COMPLETE_FINAL_HEAD_ASSURANCE",
        "QA_AND_GATE_CLASSIFICATION",
        "DETERMINISTIC_CLOSURE_AND_RECEIPT",
        "ELIGIBLE_SQUASH_MERGE",
        "PROGRAMME_STATE_CONTINUATION"
      ]
    },
    "mandatory_acceleration_conditions": {
      "const": {
        "sealed_candidate_two_phase_gate": {
          "state_sequence": ["IMPLEMENTED", "QA_REVIEW", "CANDIDATE_SEALED", "OPERATOR_DECISION_PENDING", "MERGED", "RECEIPT_RECORDED"],
          "candidate_sha_binding_required": true,
          "post_seal_candidate_mutation": "PROHIBITED",
          "decision_and_receipt_path": "SEPARATELY_GOVERNED_RECEIPT_OR_CONTROL_PATH"
        },
        "atomic_git_transaction_and_head_budget": {
          "transaction": "ONE_BLOB_TREE_COMMIT_FAST_FORWARD_UPDATE",
          "maximum_preseal_candidate_head_mutations": 2,
          "maximum_postseal_candidate_head_mutations": 0,
          "repair_after_budget": "NEW_BOUNDED_SUPERSEDING_BRANCH"
        },
        "one_active_pr_programme_lease": {
          "maximum_active_continuation_prs": 1,
          "required_predecessor_resolution": ["MERGED", "SUPERSEDED_PRESERVED", "RECORDED_NON_BLOCKING_HISTORICAL_EXCEPTION"],
          "lease_fields": ["programme_id", "packet_id", "branch", "pull_request", "lease_state", "predecessor_resolution"]
        },
        "required_check_provenance_and_ruleset_health": {
          "required_times": ["BEFORE_BRANCH_CREATION", "AFTER_WORKFLOW_OR_RULESET_CHANGE", "BEFORE_MERGE"],
          "required_fields": ["ruleset_id", "ruleset_logical_hash", "required_context", "workflow_path", "workflow_name", "job_name", "expected_check_source_identity", "event_type", "branch_pattern", "verified_at"],
          "source_identity_mismatch_result": "BLOCK"
        },
        "canonical_required_pr_runtime": {
          "runner": "ubuntu-latest",
          "python": "3.11",
          "additional_versions": "SCHEDULED_MANUAL_OR_RELEASE_SPECIFIC_UNLESS_EXPLICITLY_REQUIRED"
        }
      }
    },
    "retirement_mode": {"const": "NON_DESTRUCTIVE_RETIRED_NON_AUTHORITATIVE"},
    "retired_mechanics": {
      "const": [
        "AD_HOC_PACKET_STATE_OUTSIDE_PROGRAMME_REGISTRY",
        "MANUAL_MERGE_RECEIPT_WHEN_DETERMINISTIC_INPUTS_EXIST",
        "UNREGISTERED_CHANGED_FILE_TEST_SELECTION",
        "PACKET_EXECUTION_BYPASSING_UNIVERSAL_PREFLIGHT",
        "DUPLICATED_SHARED_DEVELOPMENT_MECHANICS"
      ]
    },
    "exceptions": {
      "const": [
        "GOVERNING_PLAN_EXPLICITLY_REQUIRES_PROGRAMME_SPECIFIC_MECHANIC",
        "NO_APPROVED_DEFAULT_ADAPTER_EXISTS",
        "OPERATOR_RESERVED_AUTHORITY_REQUIRES_GATE"
      ]
    },
    "permanent_denials": {
      "const": [
        "WRITE_MAIN",
        "BOT_MERGE_PULL_REQUEST",
        "BOT_APPROVE_PULL_REQUEST",
        "BOT_DISMISS_REVIEW",
        "FORCE_PUSH",
        "REWRITE_HISTORY",
        "DELETE_ACCEPTED_RECORD",
        "PROVIDER_ACCESS",
        "R2_WRITE",
        "RELEASE_PUBLICATION",
        "SELECTOR_OR_SEMANTIC_MUTATION",
        "ACTIVE_DISCOVERY_DEVELOPMENT_OR_VALIDATION",
        "NEW_MARKET_INSTRUMENT_CLOCK_SIDE_OR_DEPENDENCY",
        "PROBABILITY_RISK_EXPOSURE_OR_EXECUTION_AUTHORITY",
        "UNAPPROVED_AGENT_WRITE_AUTHORITY"
      ]
    },
    "rollback": {"const": "DISABLE_DEFAULT_PROFILE_RESTORE_PRIOR_SELECTION_NON_DESTRUCTIVELY_PRESERVE_HISTORY"}
  }
}
