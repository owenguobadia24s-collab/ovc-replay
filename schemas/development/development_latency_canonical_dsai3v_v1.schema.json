{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ovc-development-latency-canonical-dsai3v/v1",
  "type": "object",
  "required": ["schema", "programme_id", "packet_id", "completion_receipt_id", "devobs_context", "latency", "orch", "vit", "siq", "evidence_rule", "authority_effect", "record_id"],
  "properties": {
    "schema": {"const": "ovc-development-latency-canonical-dsai3v/v1"},
    "programme_id": {"type": "string", "minLength": 1},
    "packet_id": {"type": "string", "minLength": 1},
    "completion_receipt_id": {"type": "string", "minLength": 1},
    "devobs_context": {"type": "object"},
    "latency": {"type": "object"},
    "async_assurance": {
      "type": "object",
      "required": ["status","foreground_ci_wait_ms","background_ci_elapsed_ms","ci_development_overlap_ms","speculative_successor_ms","workflow_green_to_materialisation_ms","materialisation_ready_idle_ms","assurance_rerun_count","assurance_reuse_count","descendant_invalidation_count","speculative_work_salvaged_ms","speculative_work_discarded_ms"],
      "properties": {
        "status": {"enum":["OBSERVED","UNAVAILABLE"]},
        "foreground_ci_wait_ms": {"type":["number","null"],"minimum":0},
        "background_ci_elapsed_ms": {"type":["number","null"],"minimum":0},
        "ci_development_overlap_ms": {"type":["number","null"],"minimum":0},
        "speculative_successor_ms": {"type":["number","null"],"minimum":0},
        "workflow_green_to_materialisation_ms": {"type":["number","null"],"minimum":0},
        "materialisation_ready_idle_ms": {"type":["number","null"],"minimum":0},
        "assurance_rerun_count": {"type":["number","null"],"minimum":0},
        "assurance_reuse_count": {"type":["number","null"],"minimum":0},
        "descendant_invalidation_count": {"type":["number","null"],"minimum":0},
        "speculative_work_salvaged_ms": {"type":["number","null"],"minimum":0},
        "speculative_work_discarded_ms": {"type":["number","null"],"minimum":0}
      },
      "additionalProperties": false
    },
    "orch": {"type": "object"},
    "vit": {"type": "object"},
    "siq": {"type": "object"},
    "evidence_rule": {"const": "OBSERVED_FIELDS_ONLY_NO_UNOBSERVED_LATENCY_OR_EXECUTION_INFERENCE"},
    "authority_effect": {"const": "NONE"},
    "record_id": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
