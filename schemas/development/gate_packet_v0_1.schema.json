{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://ovc.local/schemas/development/gate_packet_v0_1.schema.json",
  "title":"OVC Development Gate Packet v0.1",
  "type":"object",
  "additionalProperties":false,
  "required":["gate_id","plan_id","plan_version","programme_id","packet_id","baseline_commit","candidate_commit","authority_delta","acceptance_conditions","tests","qa_status","warnings","unresolved_issues","changed_files","rollback","recommended_decision","next_packet","gate_packet_id","allowed_decisions"],
  "properties":{
    "gate_id":{"type":"string"},"plan_id":{"type":"string"},"plan_version":{"type":"string"},"programme_id":{"type":"string"},"packet_id":{"type":"string"},"baseline_commit":{"type":"string"},"candidate_commit":{"type":"string"},"authority_delta":{"type":"string"},
    "acceptance_conditions":{"type":"array","minItems":1,"items":{"type":"string"}},"tests":{"type":"array","minItems":1,"items":{"type":"string"}},"qa_status":{"type":"string"},"warnings":{"type":"array","items":{"type":"string"}},"unresolved_issues":{"type":"array","items":{"type":"string"}},"changed_files":{"type":"array","items":{"type":"string"}},"rollback":{"type":"string","minLength":1},"recommended_decision":{"enum":["PASS","DEFER","BLOCK","QUARANTINE","SUPERSEDE"]},"next_packet":{"type":["string","null"]},"gate_packet_id":{"type":"string","pattern":"^[0-9a-f]{64}$"},"allowed_decisions":{"type":"array","items":{"type":"string"}}
  }
}
