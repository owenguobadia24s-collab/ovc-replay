{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ovc.local/schemas/development/merge_receipt_proposal_v0_1.schema.json",
  "title": "OVC Merge Receipt Proposal v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "closure_proposal_id", "receipt", "proposal_only", "authority", "receipt_proposal_id"],
  "properties": {
    "schema": {"const": "ovc-merge-receipt-proposal/v1"},
    "closure_proposal_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "programme_id", "packet_id", "gate_id", "pull_request", "approved_head_sha",
        "squash_merge_sha", "decision", "decision_id", "authority_delta", "required_checks",
        "rollback", "next_packet"
      ],
      "properties": {
        "schema": {"const": "ovc-development-acceleration-merge-receipt/v1"},
        "programme_id": {"type": "string", "minLength": 1},
        "packet_id": {"type": "string", "minLength": 1},
        "gate_id": {"type": "string", "minLength": 1},
        "pull_request": {"type": "integer", "minimum": 1},
        "approved_head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "squash_merge_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "decision": {"const": "PASS"},
        "decision_id": {"type": "string", "minLength": 1},
        "authority_delta": {"type": "string", "minLength": 1},
        "required_checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "run_id", "result"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "run_id": {"type": "integer", "minimum": 1},
              "result": {"const": "PASS"}
            }
          }
        },
        "rollback": {"type": "string", "minLength": 1},
        "next_packet": {"type": "string", "minLength": 1}
      }
    },
    "proposal_only": {"const": true},
    "authority": {"$ref": "#/$defs/authority"},
    "receipt_proposal_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dry_run_only", "writes_performed", "merge_performed", "repository_bot_write", "direct_main_write", "force_push", "history_rewrite"],
      "properties": {
        "dry_run_only": {"const": true},
        "writes_performed": {"const": false},
        "merge_performed": {"const": false},
        "repository_bot_write": {"const": "DENIED"},
        "direct_main_write": {"const": "DENIED"},
        "force_push": {"const": "DENIED"},
        "history_rewrite": {"const": "DENIED"}
      }
    }
  }
}
