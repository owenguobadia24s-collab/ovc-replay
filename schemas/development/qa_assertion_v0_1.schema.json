{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ovc.local/schemas/development/qa_assertion_v0_1.schema.json",
  "title": "OVC Development QA Assertion v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["check_id", "target", "status", "severity", "evidence", "timestamp", "code_hash", "config_hash", "input_hash", "issue_links", "assertion_id"],
  "properties": {
    "check_id": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "status": {"enum": ["PASS", "WARN", "BLOCK", "QUARANTINE", "NOT_EVALUABLE"]},
    "severity": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "timestamp": {"type": "string", "minLength": 1},
    "code_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "issue_links": {"type": "array", "items": {"type": "string"}},
    "assertion_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
