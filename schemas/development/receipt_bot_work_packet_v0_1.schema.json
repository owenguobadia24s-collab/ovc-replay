{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ovc.local/schemas/development/receipt_bot_work_packet_v0_1.schema.json",
  "title": "OVC receipt-bot immutable work packet v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile_id",
    "profile_hash",
    "programme_id",
    "packet_id",
    "source_main_sha",
    "current_main_sha",
    "branch",
    "pull_request_title",
    "target_files",
    "closure_status",
    "qa_status",
    "decision",
    "reserved_authority_delta",
    "blockers",
    "warnings",
    "unresolved_review_count",
    "rollback",
    "idempotency_key"
  ],
  "properties": {
    "schema": {"const": "ovc-receipt-bot-work-packet/v1"},
    "profile_id": {"const": "OVC.DEVELOPMENT.ACCELERATION.RECEIPT-BOT.v0.1"},
    "profile_hash": {"const": "e3e13f38dbddbf96da075c4489e2c5e7c7a03b6f42aaa9aa564e0db2813fa0f5"},
    "programme_id": {"const": "OVC-DEV-ACCEL-v0.1"},
    "packet_id": {"type": "string", "minLength": 1},
    "source_main_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "current_main_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "branch": {"type": "string", "pattern": "^bot/ovc-dev-accel-receipts/[A-Za-z0-9._/-]+$"},
    "pull_request_title": {"type": "string", "minLength": 1},
    "target_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "content_sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "closure_status": {"const": "PASS"},
    "qa_status": {"const": "PASS"},
    "decision": {"const": "PASS"},
    "reserved_authority_delta": {"const": "NONE"},
    "blockers": {"type": "array", "maxItems": 0},
    "warnings": {"type": "array", "maxItems": 0},
    "unresolved_review_count": {"const": 0},
    "rollback": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._:-]{7,127}$"}
  }
}
