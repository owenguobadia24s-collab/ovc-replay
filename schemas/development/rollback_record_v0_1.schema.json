{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://ovc.local/schemas/development/rollback_record_v0_1.schema.json",
  "title":"OVC Development Rollback Record v0.1",
  "type":"object",
  "additionalProperties":false,
  "required":["programme_id","packet_id","target_commit","method","preserved_artifacts","prohibited_actions","rationale","rollback_id"],
  "properties":{
    "programme_id":{"type":"string"},"packet_id":{"type":"string"},"target_commit":{"type":"string"},"method":{"enum":["REVERT_COMMIT","DISABLE_PROFILE","RESTORE_SELECTOR_REFERENCE_ONLY"]},"preserved_artifacts":{"type":"array","minItems":1,"items":{"type":"string"}},"prohibited_actions":{"type":"array","minItems":3,"items":{"type":"string"}},"rationale":{"type":"string","minLength":1},"rollback_id":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
