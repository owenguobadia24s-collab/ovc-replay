{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://ovc.local/schemas/development/skills/capability_record_v0_1.schema.json","title":"CapabilityRecord v0.1","type":"object","additionalProperties":false,"required":["schema","capability_id","name","semantic_contract","consequence_class","prohibited_interpretation","minimum_maturity","status","source_refs"],"properties":{"schema":{"const":"ovc-dsai-capability-record/v1"},"capability_id":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{2,63}$"},"name":{"type":"string","minLength":1},"semantic_contract":{"type":"string","minLength":1},"consequence_class":{"enum":["GOVERNANCE","ENGINEERING","ASSURANCE","DOMAIN","ORCHESTRATION"]},"prohibited_interpretation":{"type":"string","minLength":1},"minimum_maturity":{"enum":["EXPERIMENTAL","QUALIFIED","TRUSTED"]},"status":{"enum":["ACTIVE","SUPERSEDED","QUARANTINED","REVOKED"]},"source_refs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}}}