    "PersistentDispatchAuthorityView":{"type":"object","additionalProperties":false,"required":["schema","view_id","programme_id","packet_id","decision","reason_codes","authority_effect"],"properties":{"schema":{"const":"ovc-cers-persistent-dispatch-authority-view/v1"},"view_id":{"$ref":"#/$defs/NonEmptyString"},"programme_id":{"$ref":"#/$defs/NonEmptyString"},"packet_id":{"$ref":"#/$defs/NonEmptyString"},"decision":{"enum":["ALLOW","PARK","DENY"]},"reason_codes":{"$ref":"#/$defs/StringSet"},"authority_effect":{"const":"NONE"}}},
    "PersistentQuiescenceState":{"type":"object","additionalProperties":false,"required":["schema","state_id","mode","source","generation","persistent_general_dispatch","activation_gate","authority_effect"],"properties":{"schema":{"const":"ovc-cers-persistent-quiescence-state/v1"},"state_id":{"$ref":"#/$defs/NonEmptyString"},"mode":{"enum":["RUN","DRAIN","HOLD","DISABLE_NEW_DISPATCH"]},"source":{"$ref":"#/$defs/NonEmptyString"},"generation":{"type":"integer","minimum":0},"persistent_general_dispatch":{"enum":["DENIED","AUTHORIZED_EXACT_ADMITTED_SCOPE"]},"activation_gate":{"const":"CERS-G-PERSISTENT-SUPERVISOR-ACTIVATION"},"authority_effect":{"const":"NONE"}}}
