{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://ovc.local/schemas/development/skills/execution_environment_manifest_v0_1.schema.json","title":"ExecutionEnvironmentManifest v0.1","type":"object","additionalProperties":false,"required":["schema","environment_id","os_name","architecture","python_version","toolchain","lockfile_sha256","base_environment_id","reproducibility_class","authority_effect"],"properties":{"schema":{"const":"ovc-dsai-execution-environment-manifest/v1"},"environment_id":{"type":"string","pattern":"^[0-9a-f]{64}$"},"os_name":{"type":"string","minLength":1},"architecture":{"type":"string","minLength":1},"python_version":{"type":"string","minLength":1},"toolchain":{"type":"object"},"lockfile_sha256":{"type":["string","null"]},"base_environment_id":{"type":["string","null"]},"reproducibility_class":{"enum":["EXACT_LOCKED","REPRODUCIBLE_LOCAL","PARTIAL","NON_REPRODUCIBLE"]},"authority_effect":{"const":"NONE"}}}