{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://ovc.local/schemas/development/skills/skill_manifest_v0_1.schema.json","title":"SkillManifest v0.1","type":"object","additionalProperties":false,"required":["schema","skill_id","release_id","logical_name","semantic_version","implementation_kind","implementation_path","determinism_class","availability","maturity","capability_binding_ids","dependency_manifest_id","input_contract_id","output_contract_id","permission_profile_id","source_refs"],"properties":{"schema":{"const":"ovc-dsai-skill-manifest/v1"},"skill_id":{"type":"string","pattern":"^OVC-SKILL-[0-9]{3}$"},"release_id":{"type":"string","minLength":1},"logical_name":{"type":"string","pattern":"^ovc-[a-z0-9-]+$"},"semantic_version":{"type":"string","minLength":1},"implementation_kind":{"enum":["WRAPS_EXISTING","NEW_BEHAVIOUR","COMPOSITE"]},"implementation_path":{"type":"string","minLength":1},"determinism_class":{"enum":["STRICT_DETERMINISTIC","DETERMINISTIC_GIVEN_SNAPSHOT","BOUNDED_REASONING","HUMAN_DECISION_SUPPORT"]},"availability":{"enum":["UNAVAILABLE","AVAILABLE","SUPERSEDED","QUARANTINED","REVOKED"]},"maturity":{"enum":["EXPERIMENTAL","QUALIFIED","TRUSTED"]},"capability_binding_ids":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"dependency_manifest_id":{"type":"string","minLength":1},"input_contract_id":{"type":"string","minLength":1},"output_contract_id":{"type":"string","minLength":1},"permission_profile_id":{"type":"string","minLength":1},"source_refs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}}}