{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://ovc.local/schemas/development/skills/skill_release_bundle_v0_1.schema.json","title":"SkillReleaseBundle v0.1","type":"object","additionalProperties":false,"required":["schema","skill_id","logical_name","semantic_version","release_id","normative_bundle_hash","resolved_field_classification","normative_payload","descriptive_payload","source_refs","authority_effect"],"properties":{"schema":{"const":"ovc-dsai-skill-release-bundle/v1"},"skill_id":{"type":"string","pattern":"^OVC-SKILL-[0-9]{3}$"},"logical_name":{"type":"string","pattern":"^ovc-[a-z0-9-]+$"},"semantic_version":{"type":"string","minLength":1},"release_id":{"type":"string","minLength":1},"normative_bundle_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"resolved_field_classification":{"type":"object"},"normative_payload":{"type":"object"},"descriptive_payload":{"type":"object"},"source_refs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"authority_effect":{"const":"NONE"}}}