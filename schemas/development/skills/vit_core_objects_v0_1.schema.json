{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"ovc://development/skills/vit/core-objects/v0.1",
  "title":"OVC DSAI v0.3 VIT Core Objects v0.1",
  "type":"object",
  "additionalProperties":false,
  "properties":{
    "plan_id":{},"packet_id":{},"gate_id":{},"authority_class":{},"authority_delta":{},"authority_sources":{},"reserved_boundaries":{},"security_envelope_id":{},
    "dependencies":{},"predecessor_requirement":{},"owner_bindings":{},
    "schema_version":{},"programme_id":{},"logical_changes":{},"authority_manifest_id":{},"dependency_frontier_id":{},"completion_transition":{},"payload_id":{},
    "tree_sha":{},"profile":{},"state_id":{},
    "train_generation_id":{},"ordinal":{},"predecessor_tree":{},"result_tree":{},"generation_id":{},
    "entry_packet":{},"command":{},"continuation_policy":{},"authority_source":{},"stop_boundary":{},
    "lane_id":{},"current_packet":{},"build_frontier":{},"payload_frontier":{},"vit_frontier":{},"materialisation_frontier":{},
    "commit_sha":{},"authority_frontier":{},"policy_frontier":{},
    "record_id":{},"record_type":{}
  },
  "$defs":{
    "IntegrationAuthorityManifest":{"type":"object","additionalProperties":false,"required":["plan_id","packet_id","gate_id","authority_class","authority_delta","authority_sources"],"properties":{"plan_id":{"type":"string","minLength":1},"packet_id":{"type":"string","minLength":1},"gate_id":{"type":"string","minLength":1},"authority_class":{"enum":["AUTO_EXECUTABLE","OPERATOR_REQUIRED","HARD_DENY"]},"authority_delta":{"type":"string","minLength":1},"authority_sources":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"reserved_boundaries":{"type":"array","items":{"type":"string"}},"security_envelope_id":{"type":["string","null"]}}},
    "DependencyFrontier":{"type":"object","additionalProperties":false,"required":["dependencies","predecessor_requirement"],"properties":{"dependencies":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},"predecessor_requirement":{"enum":["PHYSICAL_MATERIALISATION_REQUIRED","QUALIFIED_VIT_GENERATION_REQUIRED","PAYLOAD_OUTPUT_REQUIRED","EXECUTION_COMPLETION_REQUIRED","ORDER_ONLY","NONE"]},"owner_bindings":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true}}},
    "PacketIntegrationPayload":{"type":"object","additionalProperties":false,"required":["schema_version","programme_id","packet_id","logical_changes","authority_manifest_id","dependency_frontier_id","completion_transition","payload_id"],"properties":{"schema_version":{"const":"packet-integration-payload/v0.1"},"programme_id":{"type":"string","minLength":1},"packet_id":{"type":"string","minLength":1},"logical_changes":{"type":"array","minItems":1,"items":{"type":"object"}},"authority_manifest_id":{"type":"string","minLength":1},"dependency_frontier_id":{"type":"string","minLength":1},"completion_transition":{"type":"object"},"payload_id":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},
    "ProspectiveTreeState":{"type":"object","additionalProperties":false,"required":["tree_sha","profile","state_id"],"properties":{"tree_sha":{"type":"string","pattern":"^[0-9a-f]{40,64}$"},"profile":{"const":"git-tree-v1"},"state_id":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},
    "VirtualIntegrationGeneration":{"type":"object","additionalProperties":false,"required":["train_generation_id","ordinal","predecessor_tree","payload_id","result_tree","authority_manifest_id","dependency_frontier_id","generation_id"],"properties":{"train_generation_id":{"type":"string","minLength":1},"ordinal":{"type":"integer","minimum":0},"predecessor_tree":{"$ref":"#/$defs/ProspectiveTreeState"},"payload_id":{"type":"string","minLength":1},"result_tree":{"$ref":"#/$defs/ProspectiveTreeState"},"authority_manifest_id":{"type":"string","minLength":1},"dependency_frontier_id":{"type":"string","minLength":1},"generation_id":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},
    "ContinuousExecutionMandate":{"type":"object","additionalProperties":false,"required":["programme_id","entry_packet","command","continuation_policy","authority_source"],"properties":{"programme_id":{"type":"string","minLength":1},"entry_packet":{"type":"string","minLength":1},"command":{"enum":["RUN","CONTINUE","RUN_ONLY","CONTINUE_ONLY","HOLD"]},"continuation_policy":{"type":"string","minLength":1},"authority_source":{"type":"string","minLength":1},"stop_boundary":{"type":["string","null"]}}},
    "DevelopmentLane":{"type":"object","additionalProperties":false,"required":["lane_id","programme_id","current_packet","build_frontier"],"properties":{"lane_id":{"type":"string","minLength":1},"programme_id":{"type":"string","minLength":1},"current_packet":{"type":"string","minLength":1},"build_frontier":{"type":"string","minLength":1},"payload_frontier":{"type":["string","null"]},"vit_frontier":{"type":["string","null"]},"materialisation_frontier":{"type":["string","null"]}}},
    "PhysicalMainAnchor":{"type":"object","additionalProperties":false,"required":["commit_sha","tree_sha"],"properties":{"commit_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},"tree_sha":{"type":"string","pattern":"^[0-9a-f]{40,64}$"},"authority_frontier":{"type":"array","items":{"type":"string"}},"policy_frontier":{"type":"array","items":{"type":"string"}}}},
    "GenericClosedRecord":{"type":"object","required":["record_id","record_type","schema_version"],"properties":{"record_id":{"type":"string","minLength":1},"record_type":{"type":"string","minLength":1},"schema_version":{"type":"string","minLength":1}},"additionalProperties":true}
  },
  "oneOf":[
    {"$ref":"#/$defs/IntegrationAuthorityManifest"},{"$ref":"#/$defs/DependencyFrontier"},{"$ref":"#/$defs/PacketIntegrationPayload"},{"$ref":"#/$defs/ProspectiveTreeState"},{"$ref":"#/$defs/VirtualIntegrationGeneration"},{"$ref":"#/$defs/ContinuousExecutionMandate"},{"$ref":"#/$defs/DevelopmentLane"},{"$ref":"#/$defs/PhysicalMainAnchor"},{"$ref":"#/$defs/GenericClosedRecord"}
  ]
}
