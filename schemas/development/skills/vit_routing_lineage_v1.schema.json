{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ovc-vit-routing-lineage/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","status","programme_id","packet_id","route_class","pip","pip_id","generation","generation_id","placement","placement_id","routing"],
  "properties": {
    "schema": {"const": "ovc-vit-routing-lineage/v1"},
    "status": {"const": "ADMITTED"},
    "programme_id": {"type": "string", "minLength": 1},
    "packet_id": {"type": "string", "minLength": 1},
    "route_class": {"enum": ["VIT_MANDATORY", "REGISTERED_EXCEPTION"]},
    "pip": {
      "type": "object",
      "required": ["schema_version","programme_id","packet_id","logical_changes","authority_manifest_id","dependency_frontier_id","completion_transition"],
      "properties": {
        "schema_version": {"const": "packet-integration-payload/v0.1"},
        "programme_id": {"type": "string", "minLength": 1},
        "packet_id": {"type": "string", "minLength": 1},
        "logical_changes": {"type": "array", "minItems": 1},
        "authority_manifest_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "dependency_frontier_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "completion_transition": {"type": "object"}
      }
    },
    "pip_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train_generation_id","ordinal","predecessor_tree","payload_id","result_tree","authority_manifest_id","dependency_frontier_id"],
      "properties": {
        "train_generation_id": {"type": "string", "minLength": 1},
        "ordinal": {"type": "integer", "minimum": 0},
        "predecessor_tree": {"$ref": "#/$defs/treeState"},
        "payload_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "result_tree": {"$ref": "#/$defs/treeState"},
        "authority_manifest_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "dependency_frontier_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "generation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload_id","predecessor_tree","result_tree","apply_profile","ordinal","dependency_frontier_id","authority_manifest_id"],
      "properties": {
        "payload_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "predecessor_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "result_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "apply_profile": {"type": "string", "minLength": 1},
        "ordinal": {"type": "integer", "minimum": 0},
        "dependency_frontier_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "authority_manifest_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "placement_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controller","physical_gateway","route_class"],
      "properties": {
        "controller": {"const": "DSAI_VIT_PHYSICAL_CONTROLLER"},
        "physical_gateway": {"const": "DSAI_SIQ_EXISTING_SERIALIZED_GATEWAY"},
        "route_class": {"enum": ["VIT_MANDATORY", "REGISTERED_EXCEPTION"]}
      }
    }
  },
  "$defs": {
    "treeState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tree_sha","profile"],
      "properties": {
        "tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "profile": {"const": "git-tree-v1"}
      }
    }
  }
}
