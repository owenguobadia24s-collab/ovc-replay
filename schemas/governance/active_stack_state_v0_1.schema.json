{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ovc-active-stack-state/v0_1",
  "title": "OVC Active Stack State v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "programme_id",
    "plan_id",
    "plan_version",
    "status",
    "baseline_main",
    "operator_decision",
    "market_envelope",
    "active_spine",
    "classifications",
    "authority_overlays",
    "retained_denials"
  ],
  "properties": {
    "schema": {"const": "ovc-active-stack-state/v0_1"},
    "programme_id": {"const": "OVC-ACTIVE-STACK-RECLASSIFICATION-v0.1"},
    "plan_id": {"const": "OVC-ACTIVE-STACK-RECLASSIFICATION-v0.1"},
    "plan_version": {"const": "0.1"},
    "status": {"enum": ["QA_REVIEW", "COMPLETED", "BLOCKED", "QUARANTINED", "SUPERSEDED"]},
    "baseline_main": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "branch": {"type": "string"},
    "effective_on_main_merge": {"type": "boolean"},
    "operator_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "decision", "decision_time_local", "authority_delta"],
      "properties": {
        "command": {"const": "OVC APPROVE OVC ACTIVE STACK RECLASSIFICATION v0.1"},
        "decision": {"const": "PASS"},
        "decision_time_local": {"type": "string"},
        "authority_delta": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "precedence": {"type": "object"},
    "market_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instrument", "sides", "clocks", "research_roles", "validation"],
      "properties": {
        "instrument": {"const": "GBPUSD"},
        "sides": {"type": "array", "const": ["BID", "ASK"]},
        "clocks": {"type": "array", "const": ["15M", "2H_A_L"]},
        "research_roles": {"type": "array", "const": ["DISCOVERY", "DEVELOPMENT"]},
        "validation": {"const": "LOCKED_UNCONSUMED"}
      }
    },
    "active_spine": {
      "type": "array",
      "const": ["OPT-A", "OPT-B.C1.v2", "OPT-B.C2.vNext", "OPT-B.C2E.v0.2"]
    },
    "classifications": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ACTIVE", "ACTIVE_FOUNDATION", "SHADOW", "NON_EVALUABLE", "LEGACY_INACTIVE", "LOCKED"],
      "properties": {
        "ACTIVE": {"type": "array", "items": {"type": "string"}},
        "ACTIVE_FOUNDATION": {"type": "array", "items": {"type": "string"}},
        "SHADOW": {"type": "array", "items": {"type": "string"}},
        "NON_EVALUABLE": {"type": "array", "items": {"type": "string"}},
        "LEGACY_INACTIVE": {"type": "array", "items": {"type": "string"}},
        "LOCKED": {"type": "array", "items": {"type": "string"}}
      }
    },
    "authority_overlays": {"type": "object"},
    "retained_denials": {"type": "array", "items": {"type": "string"}}
  }
}
