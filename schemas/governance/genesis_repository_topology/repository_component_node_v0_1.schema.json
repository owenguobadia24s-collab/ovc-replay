{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ovc://schemas/governance/genesis-repository-topology/repository-component-node/v0.1",
  "title": "RepositoryComponentNode v0.1",
  "type": "object",
  "required": ["component_id","component_type","path","logical_name","repository","commit","blob_hash_or_tree_hash","owner_programme_id","owner_genesis_id","authority_state","implementation_state","lifecycle_state","option_or_domain","layer","version","schema_version","release_id","qa_state","freshness_state","historical_state","source_precedence","source_refs","created_from","last_verified_at"],
  "properties": {
    "component_id": {"type": "string", "pattern": "^GRT\\.COMP\\."},
    "component_type": {"type": "string"},
    "path": {"type": "string"},
    "logical_name": {"type": "string"},
    "repository": {"type": "string"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "blob_hash_or_tree_hash": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "owner_programme_id": {"type": ["string","null"]},
    "owner_programme_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "owner_genesis_id": {"type": ["string","null"]},
    "authority_state": {"type": "string"},
    "implementation_state": {"type": "string"},
    "lifecycle_state": {"type": "string"},
    "option_or_domain": {"type": ["string","null"]},
    "layer": {"type": ["string","null"]},
    "version": {"type": ["string","null"]},
    "schema_version": {"type": ["string","null"]},
    "release_id": {"type": ["string","null"]},
    "qa_state": {"type": "string"},
    "freshness_state": {"type": "string"},
    "historical_state": {"type": "string"},
    "source_precedence": {"type": "integer", "minimum": 1},
    "source_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "created_from": {"type": "string"},
    "last_verified_at": {"type": "string"},
    "ownership_evidence": {"type": "array"}
  },
  "additionalProperties": true
}
