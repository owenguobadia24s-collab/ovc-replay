{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ovc.local/schemas/governance/programme_genesis/scope_audit_v0_1.schema.json",
  "title": "Programme Genesis Scope Audit v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_type", "schema_version", "scope_audit_id", "proposal_id", "creation_triggers", "comparisons", "fit_checks", "result", "review_gate", "source_refs"],
  "properties": {
    "record_type": {"const": "SCOPE_AUDIT"},
    "schema_version": {"const": "0.1"},
    "scope_audit_id": {"type": "string", "pattern": "^PGSCOPE\\."},
    "proposal_id": {"type": "string", "minLength": 1},
    "creation_triggers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["NEW_AUTHORITY_DOMAIN", "MULTI_PACKET_LIFECYCLE", "INDEPENDENT_RESEARCH_OR_RELEASE_LINE", "CROSS_CUTTING_SHARED_SERVICE", "PROGRAMME_SUPERSESSION", "PORTFOLIO_LEVEL_OPERATOR_DECISION"]}
    },
    "comparisons": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["existing_programme_id", "similarity_basis", "packet_fit", "correction_fit", "incident_fit", "maintenance_fit", "negative_fit_evidence", "source_refs"],
        "properties": {
          "existing_programme_id": {"type": "string", "minLength": 1},
          "similarity_basis": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "packet_fit": {"enum": ["NO", "YES", "UNKNOWN"]},
          "correction_fit": {"enum": ["NO", "YES", "UNKNOWN"]},
          "incident_fit": {"enum": ["NO", "YES", "UNKNOWN"]},
          "maintenance_fit": {"enum": ["NO", "YES", "UNKNOWN"]},
          "negative_fit_evidence": {"type": "string", "minLength": 20},
          "source_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
        }
      }
    },
    "fit_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all_three_compared", "no_existing_fit", "maintenance_registry_checked", "reserved_authority_fail_closed"],
      "properties": {
        "all_three_compared": {"const": true},
        "no_existing_fit": {"const": true},
        "maintenance_registry_checked": {"const": true},
        "reserved_authority_fail_closed": {"const": true}
      }
    },
    "result": {"enum": ["ADMISSIBLE_FOR_GENESIS_REVIEW", "FIT_EXISTING_PROGRAMME", "NOT_EVALUABLE", "BLOCK", "QUARANTINE"]},
    "review_gate": {"type": "string", "minLength": 1},
    "source_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "notes": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"result": {"const": "ADMISSIBLE_FOR_GENESIS_REVIEW"}}},
      "then": {
        "properties": {
          "comparisons": {
            "items": {
              "properties": {
                "packet_fit": {"const": "NO"},
                "correction_fit": {"const": "NO"},
                "incident_fit": {"const": "NO"},
                "maintenance_fit": {"const": "NO"}
              }
            }
          }
        }
      }
    }
  ]
}
