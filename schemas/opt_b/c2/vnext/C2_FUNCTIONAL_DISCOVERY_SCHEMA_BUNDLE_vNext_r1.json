{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ovc://schemas/opt_b/c2/vnext/functional-discovery/v1",
  "title": "C2 vNext Functional Discovery Schema Bundle",
  "status": "CANDIDATE_METHOD_NOT_ADMITTED_PENDING_CEAR_G10",
  "active": false,
  "canonical": false,
  "$defs": {
    "authorityFields": {
      "type": "object",
      "properties": {
        "active": {"const": false},
        "canonical": {"const": false},
        "authority": {"const": "PROVISIONAL_DISCOVERY_RESEARCH_ONLY"}
      },
      "required": ["active", "canonical", "authority"]
    },
    "opportunity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "opportunity_id", "discovery_view_id", "discovery_view_version",
        "registered_scope_id", "input_manifest_sha256", "source_unit_id", "opportunity_type",
        "clock_id", "side", "frame_id", "object_family", "first_valid_time",
        "start_condition", "ordered_development", "ending_structural_effect",
        "duration_observations", "path_geometry", "object_ids", "context_ids",
        "missingness", "assurance", "opportunity_outcome", "reason_codes",
        "numerator_member", "overlap_cluster_ids", "matching_stratum",
        "active", "canonical", "authority", "content_sha256"
      ],
      "properties": {
        "schema": {"const": "c2_discovery_opportunity/vnext-r1"},
        "opportunity_id": {"type": "string", "pattern": "^C2\\.OPPORTUNITY\\."},
        "discovery_view_id": {"type": "string", "minLength": 1},
        "discovery_view_version": {"type": "string", "minLength": 1},
        "registered_scope_id": {"type": "string", "minLength": 1},
        "input_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_unit_id": {"type": "string", "minLength": 1},
        "opportunity_type": {"type": "string", "minLength": 1},
        "clock_id": {"type": "string", "minLength": 1},
        "side": {"type": "string", "minLength": 1},
        "frame_id": {"type": "string", "minLength": 1},
        "object_family": {"type": "string", "minLength": 1},
        "first_valid_time": {"type": "string", "minLength": 1},
        "start_condition": {"type": "object"},
        "ordered_development": {"type": "array", "minItems": 1},
        "ending_structural_effect": {"type": "object"},
        "duration_observations": {"type": "integer", "minimum": 0},
        "path_geometry": {"type": "object"},
        "object_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "context_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "missingness": {"type": "object"},
        "assurance": {"type": "object"},
        "opportunity_outcome": {"enum": ["APPLICABLE", "NOT_APPLICABLE", "COMPUTABLE", "NOT_EVALUABLE", "CENSORED", "CONFLICT", "POLICY_UNRESOLVED", "AUTHORITY_BLOCKED"]},
        "reason_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "numerator_member": {"type": "boolean"},
        "overlap_cluster_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "matching_stratum": {"type": "object"},
        "active": {"const": false},
        "canonical": {"const": false},
        "authority": {"const": "PROVISIONAL_DISCOVERY_RESEARCH_ONLY"},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "fingerprint_id", "method_pack_id", "method_pack_version", "opportunity_id", "source_unit_id", "clock_id", "side", "frame_id", "object_family", "first_valid_time", "features", "tokens", "token_count", "active", "canonical", "authority", "content_sha256"],
      "properties": {
        "schema": {"const": "c2_neutral_sequence_fingerprint/vnext-r1"},
        "fingerprint_id": {"type": "string", "pattern": "^C2\\.FINGERPRINT\\."},
        "method_pack_id": {"type": "string"},
        "method_pack_version": {"type": "string"},
        "opportunity_id": {"type": "string"},
        "source_unit_id": {"type": "string"},
        "clock_id": {"type": "string"},
        "side": {"type": "string"},
        "frame_id": {"type": "string"},
        "object_family": {"type": "string"},
        "first_valid_time": {"type": "string"},
        "features": {"type": "object", "additionalProperties": {"type": "string"}},
        "tokens": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "token_count": {"type": "integer", "minimum": 1},
        "active": {"const": false},
        "canonical": {"const": false},
        "authority": {"const": "PROVISIONAL_DISCOVERY_RESEARCH_ONLY"},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "functionalCoreComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_key", "feature_value", "count", "frequency", "classification"],
      "properties": {
        "feature_key": {"type": "string"},
        "feature_value": {"type": "string"},
        "count": {"type": "integer", "minimum": 1},
        "frequency": {"type": "number", "minimum": 0, "maximum": 1},
        "classification": {"enum": ["INVARIANT", "COMMON", "OPTIONAL", "RARE", "CONTRADICTORY"]}
      }
    },
    "functionalCore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "functional_core_id", "family_id", "method_pack_id", "member_fingerprint_ids", "member_opportunity_ids", "member_count", "component_matrix", "classification_counts", "semantic_name", "provisional", "active", "canonical", "authority"],
      "properties": {
        "schema": {"const": "c2_functional_core/vnext-r1"},
        "functional_core_id": {"type": "string", "pattern": "^C2\\.FUNCTIONAL\\.CORE\\."},
        "family_id": {"type": "string"},
        "method_pack_id": {"type": "string"},
        "member_fingerprint_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "member_opportunity_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "member_count": {"type": "integer", "minimum": 1},
        "component_matrix": {"type": "array", "items": {"$ref": "#/$defs/functionalCoreComponent"}},
        "classification_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "semantic_name": {"type": "null"},
        "provisional": {"const": true},
        "active": {"const": false},
        "canonical": {"const": false},
        "authority": {"const": "PROVISIONAL_DISCOVERY_RESEARCH_ONLY"}
      }
    },
    "ruleAst": {
      "type": "object",
      "required": ["operator"],
      "properties": {
        "operator": {"enum": ["ALL_OF", "ANY_OF", "SEQUENCE", "WITHIN_N_OBSERVATIONS", "SAME_OBJECT", "MEASUREMENT_COMPARISON", "RELATION_TRANSITION", "RUN_LENGTH", "CONTEXT_AVAILABILITY"]}
      }
    },
    "ruleCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "rule_candidate_id", "functional_core_id", "family_id", "method_pack_id", "ast", "source_opportunity_ids", "source_fingerprint_ids", "first_valid_completion_rule", "active", "canonical", "selector_authority", "event_authority", "episode_authority", "semantic_authority", "outcome_authority", "authority", "content_sha256"],
      "properties": {
        "schema": {"const": "c2_declarative_research_rule_candidate/vnext-r1"},
        "rule_candidate_id": {"type": "string", "pattern": "^C2\\.RULE\\.CANDIDATE\\."},
        "functional_core_id": {"type": "string"},
        "family_id": {"type": "string"},
        "method_pack_id": {"type": "string"},
        "ast": {"$ref": "#/$defs/ruleAst"},
        "source_opportunity_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "source_fingerprint_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "first_valid_completion_rule": {"type": "string"},
        "active": {"const": false},
        "canonical": {"const": false},
        "selector_authority": {"const": "NONE"},
        "event_authority": {"const": "NONE"},
        "episode_authority": {"const": "NONE"},
        "semantic_authority": {"const": "NONE"},
        "outcome_authority": {"const": "NONE"},
        "authority": {"const": "PROVISIONAL_DISCOVERY_RESEARCH_ONLY"},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "explicitly_not_granted": [
    "DISCOVERY_METHOD_FREEZE",
    "FUNCTIONAL_OR_RULE_CANDIDATE_PASS",
    "RESEARCH_CONSUMER_PERMISSION",
    "SELECTOR_EVENT_EPISODE_SEMANTIC_OUTCOME_AUTHORITY",
    "VALIDATION_PUBLICATION_PROBABILITY_RISK_EXPOSURE_TRADING_EXECUTION"
  ]
}
