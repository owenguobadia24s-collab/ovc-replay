{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ovc://schemas/opt_b/c2/vnext/c2_parent_context_bundle.schema.json",
  "title": "C2 Parent Context Bundle vNext r1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "bundle_id",
    "resolver_id",
    "resolver_version",
    "local_observation_id",
    "local_first_valid_time",
    "expected_parent_slot_start",
    "expected_parent_slot_end",
    "fixed_parent_observation_link",
    "parent_measurement_link",
    "parent_structural_links_by_depth",
    "parent_axis_context_link",
    "local_in_parent_frame_profile",
    "higher_order_local_clock_projection",
    "higher_scale_episode_link",
    "component_computability",
    "global_degraded_state",
    "universal_staleness_threshold",
    "fallback_parent_id",
    "active",
    "canonical",
    "semantic_authority",
    "episode_authority",
    "consumer_denominator_authority",
    "authority",
    "content_sha256"
  ],
  "properties": {
    "schema": {"const": "c2_parent_context_bundle/vnext-r1"},
    "bundle_id": {"type": "string", "minLength": 1},
    "resolver_id": {"const": "C2.PARENT.CONTEXT.RESOLVER.v1"},
    "resolver_version": {"const": "1"},
    "local_observation_id": {"type": "string", "minLength": 1},
    "local_first_valid_time": {"type": "string", "format": "date-time"},
    "expected_parent_slot_start": {"type": "string", "format": "date-time"},
    "expected_parent_slot_end": {"type": "string", "format": "date-time"},
    "fixed_parent_observation_link": {"$ref": "c2_parent_context_link.schema.json"},
    "parent_measurement_link": {"$ref": "c2_parent_context_link.schema.json"},
    "parent_structural_links_by_depth": {
      "type": "array",
      "items": {"$ref": "c2_parent_context_link.schema.json"}
    },
    "parent_axis_context_link": {"$ref": "c2_parent_context_link.schema.json"},
    "local_in_parent_frame_profile": {"type": "object"},
    "higher_order_local_clock_projection": {"type": "object"},
    "higher_scale_episode_link": {"type": "object"},
    "component_computability": {"type": "object"},
    "global_degraded_state": {"type": "null"},
    "universal_staleness_threshold": {"type": "null"},
    "fallback_parent_id": {"type": "null"},
    "active": {"const": false},
    "canonical": {"const": false},
    "semantic_authority": {"const": "NONE"},
    "episode_authority": {"const": "NONE"},
    "consumer_denominator_authority": {"const": "NONE"},
    "authority": {"const": "SHADOW_FROZEN_READ_ONLY"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
