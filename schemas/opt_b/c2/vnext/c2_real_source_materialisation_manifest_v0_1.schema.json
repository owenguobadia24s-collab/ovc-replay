    "source": {"type": "object"},
    "scope": {"type": "object"},
    "policy": {"type": "object"},
    "counts": {"type": "object"},
    "files": {"type": "object"},
    "authority": {"type": "object"},
    "logical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
