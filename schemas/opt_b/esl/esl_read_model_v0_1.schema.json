{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"ovc-esl-read-model/v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","read_model_id","projection_mode","source_refs","projections","authority","lineage_refs","calculation_policy","authority_effect"],
  "properties":{
    "schema":{"const":"ovc-esl-read-model/v1"},
    "read_model_id":{"type":"string","pattern":"^eslrm1:[0-9a-f]{64}$"},
    "projection_mode":{"const":"READ_ONLY"},
    "source_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "projections":{
      "type":"object","additionalProperties":false,
      "required":["occurrence","evidence_frontier","states","sri","organisation","constraint","qualification","ast","render"],
      "properties":{
        "occurrence":{},"evidence_frontier":{},"states":{},"sri":{},"organisation":{},"constraint":{},"qualification":{},"ast":{},"render":{}
      }
    },
    "authority":{"type":"object"},
    "lineage_refs":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "calculation_policy":{"const":"NO_FRONTEND_SCIENTIFIC_CALCULATION"},
    "authority_effect":{"const":"NONE"}
  }
}
