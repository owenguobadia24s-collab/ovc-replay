{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ovc://schemas/opt_b/market_grammar/c2e_ledger_v0_1",
  "title": "C2E Ledger v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["ledger_id","policy_id","source_release_id","instrument_id","side","scope_id","clock_id","build_cutoff","input_record_ids","input_source_sha256","episodes","not_evaluable","schema_version","authority_state"],
  "properties": {
    "ledger_id": {"type":"string","pattern":"^C2E\\.LD\\.[0-9a-f]{64}$"},
    "policy_id": {"const":"MG-C2E-BOUNDARY-v0.1"},
    "source_release_id": {"type":"string","minLength":1},
    "instrument_id": {"type":"string","minLength":1},
    "side": {"enum":["BID","ASK"]},
    "scope_id": {"type":"string","minLength":1},
    "clock_id": {"type":"string","minLength":1},
    "build_cutoff": {"type":"string","format":"date-time"},
    "input_record_ids": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "input_source_sha256": {"type":"array","minItems":1,"items":{"type":"string","pattern":"^[0-9a-f]{64}$"}},
    "episodes": {"type":"array","items":{"$ref":"c2e_episode_record_v0_1.schema.json"}},
    "not_evaluable": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["source_record_id","first_valid_time","computability_status","reason","source_sha256"],"properties":{"source_record_id":{"type":"string","minLength":1},"first_valid_time":{"type":"string","format":"date-time"},"computability_status":{"enum":["NOT_EVALUATED","NOT_EVALUABLE","STALE","CENSORED","CONFLICT","QUARANTINED"]},"reason":{"type":"string","minLength":1},"source_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}},
    "schema_version": {"const":"0.1"},
    "authority_state": {"const":"SHADOW_EXPERIMENT"}
  }
}
