    "result_id": {"minLength": 1, "type": "string"},
    "right_field_id": {"minLength": 1, "type": "string"},
    "value": {"type": ["number", "null"]}
  },
  "required": ["result_id", "left_field_id", "right_field_id", "method", "method_status", "comparability_domain_id", "n_comparable", "value", "control_ids", "authority"],
  "title": "MCARB Auxiliary DependenceResult v0.1",
  "type": "object"
