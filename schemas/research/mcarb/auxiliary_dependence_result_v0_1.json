{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority": {"const": "DESCRIPTIVE_ONLY"},
    "comparability_domain_id": {"minLength": 1, "type": "string"},
    "control_ids": {"items": {"type": "string"}, "type": "array"},
    "left_field_id": {"minLength": 1, "type": "string"},
    "method": {"enum": ["PEARSON", "RANK", "MUTUAL_INFORMATION"]},
    "method_status": {"enum": ["ENABLED", "DISABLED_UNTIL_PREREGISTERED"]},
