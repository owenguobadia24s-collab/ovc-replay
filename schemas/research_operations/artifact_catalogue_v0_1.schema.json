{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ovc.local/schemas/research_operations/artifact_catalogue_v0_1.schema.json",
  "title": "OVC Research Operations Artifact Catalogue v0.1",
  "type": "object",
  "required": ["schema", "generated_at", "source_commit", "nodes", "issues", "logical_inventory_sha256"],
  "properties": {
    "schema": {"const": "ovc-research-operations-artifact-catalogue/v0.1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "source_commit": {"type": "string", "minLength": 1},
    "logical_inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/ArtifactNode"}},
    "issues": {"type": "array", "items": {"$ref": "#/$defs/CatalogueIssue"}}
  },
  "$defs": {
    "PortableLocation": {
      "type": "object",
      "required": ["root_alias", "relative_path"],
      "properties": {"root_alias": {"type": "string"}, "relative_path": {"type": "string"}},
      "additionalProperties": false
    },
    "ArtifactNode": {
      "type": "object",
      "required": ["artifact_id", "artifact_type", "owner", "authority", "locations", "availability", "source_kind"],
      "properties": {
        "artifact_id": {"type": "string"}, "artifact_type": {"type": "string"}, "owner": {"type": "string"},
        "authority": {"type": "string"}, "release_id": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"]}, "size_bytes": {"type": ["integer", "null"], "minimum": 0},
        "media_type": {"type": ["string", "null"]}, "locations": {"type": "array", "items": {"$ref": "#/$defs/PortableLocation"}},
        "availability": {"enum": ["NOT_EVALUATED", "LOCAL_PRESENT", "LOCAL_VERIFIED", "REMOTE_PRESENT", "REMOTE_VERIFIED", "PARTIALLY_AVAILABLE", "MISSING", "EXPIRED", "QUARANTINED"]},
        "expires_at": {"type": ["string", "null"]}, "dependencies": {"type": "array", "items": {"type": "string"}},
        "source_kind": {"enum": ["LOCAL", "GITHUB_ACTIONS", "R2"]}, "metadata": {"type": "object"}
      },
      "additionalProperties": false
    },
    "CatalogueIssue": {
      "type": "object",
      "required": ["code", "severity", "artifact_id", "detail"],
      "properties": {"code": {"type": "string"}, "severity": {"enum": ["WARN", "BLOCK"]}, "artifact_id": {"type": "string"}, "detail": {"type": "string"}},
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
