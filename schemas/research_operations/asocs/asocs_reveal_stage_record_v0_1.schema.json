{
  "$id": "ovc/asocs/reveal-stage-record/v0_1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ASOCSRevealStageRecord",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "ovc-asocs-reveal-stage-record/v0_1"},
    "programme_id": {"const": "OVC-ASOCS-6M-v0.1"},
    "session": {"type": "integer", "minimum": 1},
    "presentation_ordinal": {"type": "integer", "minimum": 1},
    "case_id": {"type": "string", "pattern": "^ASOCS\\.BLIND\\."},
    "stage": {
      "enum": [
        "SOURCE_C1_FIDELITY",
        "C2_PRIMITIVE_STRUCTURE",
        "C2_COMPOSITION",
        "C2E_TEMPORAL",
        "OCCURRENCE_CONTEXT_FIREWALL"
      ]
    },
    "predecessor_blind_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "review_unit_id": {"type": "string", "minLength": 1},
    "revealed_surfaces": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1,
      "uniqueItems": true
    },
    "human_judgement": {"type": "object"},
    "session_human_input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "case_validation_status": {"const": "PASS"},
    "frozen_before_next_reveal": {"const": true},
    "authority_class": {"const": "ASOCS_AUDIT_ONLY_NONAUTHORITATIVE_HUMAN_RESEARCH_EVIDENCE"},
    "unrecoverable_provenance_warning": {
      "const": "UNRECOVERABLE_HISTORICAL_G3_CENSUS_IDENTITY_AND_COMPACT_MANIFEST_PROVENANCE_PERMANENT"
    }
  },
  "required": [
    "schema",
    "programme_id",
    "session",
    "presentation_ordinal",
    "case_id",
    "stage",
    "predecessor_blind_record_sha256",
    "review_unit_id",
    "revealed_surfaces",
    "human_judgement",
    "session_human_input_sha256",
    "case_validation_status",
    "frozen_before_next_reveal",
    "authority_class",
    "unrecoverable_provenance_warning"
  ]
}
