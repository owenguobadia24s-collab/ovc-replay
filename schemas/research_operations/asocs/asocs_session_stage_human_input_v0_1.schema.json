{
  "$id": "ovc/asocs/session-stage-human-input/v0_1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ASOCSSessionStageHumanInput",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "ovc-asocsi-wp8-session-stage-human-input/v0_1"},
    "programme_id": {"const": "OVC-ASOCS-6M-v0.1"},
    "session": {"type": "integer", "minimum": 1},
    "stage": {"const": "SOURCE_C1_FIDELITY"},
    "reveal_packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "presentation_ordinal": {"type": "integer", "minimum": 1},
          "case_id": {"type": "string", "pattern": "^ASOCS\\.BLIND\\."},
          "predecessor_blind_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "review_unit_id": {"type": "string", "minLength": 1},
          "human_judgement": {"$ref": "asocs_stage1_fidelity_judgement_v0_1.schema.json"}
        },
        "required": [
          "presentation_ordinal",
          "case_id",
          "predecessor_blind_record_sha256",
          "review_unit_id",
          "human_judgement"
        ]
      }
    }
  },
  "required": [
    "schema",
    "programme_id",
    "session",
    "stage",
    "reveal_packet_sha256",
    "cases"
  ]
}
