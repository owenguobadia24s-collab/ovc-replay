{
  "$defs": {
    "OutcomeRecord": {
      "$id": "https://ovc.local/schemas/research_operations/bcwt/v0_1/outcome_record.schema.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "anchor_spec_id": {"type": "string"},
        "authority_effect": {"const": "NONE"},
        "consequence_pack_id": {"type": "string"},
        "horizon_observed_bars": {"minimum": 1, "type": "integer"},
        "join_manifest_id": {"type": "string"},
        "logical_id": {"pattern": "^bcwt:outcome:", "type": "string"},
        "measurement_spec_id": {"type": "string"},
        "measurement_state": {"type": "string"},
        "observer_state_id": {"type": "string"},
        "origin_id": {"type": "string"},
        "schema": {"const": "ovc-bcwt-outcome-record/v0_1"},
        "scientific_effect": {"const": "NONE"},
        "terminal_status": {"enum": ["OBSERVED","CENSORED_GAP","CENSORED_RELEASE_END","NOT_EVALUABLE","NOT_COMPARABLE","QUARANTINED","PROCESS_INVALID"]},
        "value": {"type": ["number", "integer", "null"]}
      },
      "required": ["schema","logical_id","origin_id","observer_state_id","consequence_pack_id","join_manifest_id","anchor_spec_id","horizon_observed_bars","measurement_spec_id","terminal_status","measurement_state","value","authority_effect","scientific_effect"],
      "title": "BCWT Outcome Record v0.1",
      "type": "object"
    }
  },
  "$id": "https://ovc.local/schemas/research_operations/bcwt/v0_1/outcome_ledger.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actual_rows": {"minimum": 0, "type": "integer"},
    "authority_effect": {"const": "NONE"},
    "consequence_pack_id": {"type": "string"},
    "expected_rows": {"minimum": 0, "type": "integer"},
    "join_manifest_id": {"type": "string"},
    "logical_id": {"pattern": "^bcwt:ledger:", "type": "string"},
    "records": {"items": {"$ref": "#/$defs/OutcomeRecord"}, "type": "array"},
    "schema": {"const": "ovc-bcwt-outcome-ledger/v0_1"},
    "scientific_effect": {"const": "NONE"},
    "terminal_status_counts": {"type": "object"}
  },
  "required": ["schema","logical_id","join_manifest_id","consequence_pack_id","expected_rows","actual_rows","terminal_status_counts","records","authority_effect","scientific_effect"],
  "title": "BCWT Outcome Ledger v0.1",
  "type": "object"
}
