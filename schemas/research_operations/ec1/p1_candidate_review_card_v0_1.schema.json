      "required": [
        "node_id",
        "node_predicate",
        "result",
        "evidence_refs",
        "branch_taken",
        "human_scientific_review",
        "human_review_note"
      ]
    },
    "information_dimension_requirement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "type": "string",
          "enum": [
            "market_truth",
            "atomic_facts",
            "structural_description",
            "persistent_identity",
            "organisation",
            "conditional_constraint",
            "event_proposition",
            "semantic_composition",
            "consequence_measurement",
            "comparative_proof"
          ]
        },
        "dependency_role": {
          "type": "string",
          "enum": [
            "REQUIRED_TO_ANSWER",
            "QUALIFYING_ONLY",
            "OUT_OF_SCOPE"
          ]
        }
      },
      "required": [
        "dimension",
        "dependency_role"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "proposal_review_status": {
            "const": "PROPOSAL_ELIGIBLE"
          }
        },
        "required": [
          "proposal_review_status"
        ]
      },
      "then": {
        "properties": {
          "population_complete": {
            "const": true
          },
          "search_complete": {
            "const": true
          },
          "outcome_validation_firewall_status": {
            "const": "PASS"
          },
          "identity_field_freeze_status": {
            "const": "PASS"
          },
          "required_search_execution_status": {
            "const": "PASS"
          },
          "eligibility_failed_conditions": {
            "maxItems": 0
          },
          "recurrence_status": {
            "const": "RECURRENCE_PRESENT"
          },
          "raw_occurrence_count": {
            "minimum": 2
          },
          "minimal_generator_refs": {
            "minItems": 1
          },
          "negative_evidence_complete": {
            "const": true
          },
          "capacity_state": {
            "const": "COMPLETE"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "p1_disposition": {
            "const": "FREEZE_CANDIDATE"
          }
        },
        "required": [
          "p1_disposition"
        ]
      },
      "then": {
        "properties": {
          "proposal_review_status": {
            "const": "PROPOSAL_ELIGIBLE"
          },
          "qa_status": {
            "enum": [
              "PASS",
              "WARN"
            ]
          },
          "reproduction_status": {
            "enum": [
              "REPRODUCED",
              "METAMORPHICALLY_EQUIVALENT"
            ]
          },
          "capacity_state": {
            "const": "COMPLETE"
          },
          "adversarial_review_complete": {
            "const": true
          },
          "blocking_adversarial_failures": {
            "maxItems": 0
          },
          "reserved_action_requested": {
            "const": "PREPARE_EC1_GSCI_CANDIDATE_FREEZE"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "population_family": {
            "const": "P1C"
          }
        },
        "required": [
          "population_family"
        ]
      },
      "then": {
        "required": [
          "c2e_boundary_pack_ref"
        ],
        "properties": {
          "c2e_boundary_pack_ref": {
            "$ref": "#/$defs/object_ref"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reproduction_status": {
            "const": "REPRODUCTION_MISMATCH"
          }
        },
        "required": [
          "reproduction_status"
        ]
      },
      "then": {
        "properties": {
          "reserved_action_requested": {
            "const": "NONE"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "context_membership_invariance_status": {
            "const": "BLOCK"
          }
        },
        "required": [
          "context_membership_invariance_status"
        ]
      },
      "then": {
        "properties": {
          "reserved_action_requested": {
            "const": "NONE"
          },
          "proposal_review_status": {
            "not": {
              "const": "PROPOSAL_ELIGIBLE"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "pseudo_independence_qa_status": {
            "const": "BLOCK"
          }
        },
        "required": [
          "pseudo_independence_qa_status"
        ]
      },
      "then": {
        "properties": {
          "reserved_action_requested": {
            "const": "NONE"
          },
          "p1_disposition": {
            "not": {
              "const": "FREEZE_CANDIDATE"
            }
          }
        }
      }
    }
  ]
