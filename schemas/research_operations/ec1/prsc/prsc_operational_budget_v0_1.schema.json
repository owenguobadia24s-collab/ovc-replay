{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OVC PRSCOperationalBudget v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "budget_id", "source", "synthetic_tiers", "limits", "authority_effect"],
  "properties": {
    "schema_version": {"const": "prsc_operational_budget/v0.1"},
    "budget_id": {"type": "string", "minLength": 1},
    "source": {"const": "MEASURED_NON_SCIENTIFIC_SYNTHETIC_EVIDENCE"},
    "synthetic_tiers": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "limits": {"type": "object", "additionalProperties": {"type": ["integer", "number", "string"]}},
    "scope_reduction_permitted": {"const": false},
    "sampling_permitted": {"const": false},
    "authority_effect": {"const": "NONE"}
  }
}
