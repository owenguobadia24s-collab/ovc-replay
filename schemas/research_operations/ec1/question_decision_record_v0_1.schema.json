  "allOf": [
    {
      "if": {
        "properties": {
          "answerability": {
            "const": "ANSWERED"
          }
        },
        "required": [
          "answerability"
        ]
      },
      "then": {
        "properties": {
          "population_complete": {
            "const": true
          },
          "search_complete": {
            "const": true
          },
          "qa_status": {
            "enum": [
              "PASS",
              "WARN"
            ]
          },
          "reproduction_status": {
            "enum": [
              "REPRODUCED",
              "METAMORPHICALLY_EQUIVALENT"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "architecture_need_supported": {
            "const": true
          }
        },
        "required": [
          "architecture_need_supported"
        ]
      },
      "then": {
        "required": [
          "counterfactual_sufficiency_review",
          "upper_layer_need_record_ref"
        ],
        "properties": {
          "counterfactual_review_complete": {
            "const": true
          },
          "owner_route": {
            "not": {
              "const": "NONE"
            }
          },
          "upper_layer_need_record_ref": {
            "$ref": "#/$defs/object_ref"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reserved_action_requested": {
            "const": "ROUTE_UPPER_LAYER_OWNER_REVIEW"
          }
        },
        "required": [
          "reserved_action_requested"
        ]
      },
      "then": {
        "properties": {
          "architecture_need_supported": {
            "const": true
          },
          "next_route": {
            "const": "ROUTE_OWNER_REVIEW"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reserved_action_requested": {
            "const": "PREPARE_EC1_GSCI_CANDIDATE_FREEZE"
          }
        },
        "required": [
          "reserved_action_requested"
        ]
      },
      "then": {
        "properties": {
          "candidate_review_card_refs": {
            "minItems": 1
          },
          "next_route": {
            "const": "PREPARE_EC1_GSCI"
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "qa_status": {
                "enum": [
                  "BLOCK",
                  "QUARANTINE"
                ]
              }
            },
            "required": [
              "qa_status"
            ]
          },
          {
            "properties": {
              "reproduction_status": {
                "const": "REPRODUCTION_MISMATCH"
              }
            },
            "required": [
              "reproduction_status"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "reserved_action_requested": {
            "const": "NONE"
          }
        }
      }
    }
  ]
