{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ovc.local/schemas/research_operations/mta/mta_registry_entry_v0_1.schema.json",
  "title": "OVC MTA Registry Entry v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_entry_id",
    "registry_kind",
    "version",
    "name",
    "status",
    "owner",
    "definition",
    "authority",
    "source_lineage"
  ],
  "properties": {
    "registry_entry_id": {"type": "string", "pattern": "^MTA\\.(FLOW_OBJECT|METRIC|COMPUTABILITY|REASON|MARKER_FUNCTION)\\.[A-Z0-9_.-]+\\.v[0-9]+$"},
    "registry_kind": {"enum": ["FLOW_OBJECT", "METRIC", "COMPUTABILITY_STATUS", "REASON_CODE", "MARKER_FUNCTION"]},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "name": {"type": "string", "minLength": 1},
    "status": {"enum": ["ACTIVE_AUDIT", "REFERENCE_ONLY", "DEFERRED", "PROHIBITED", "SUPERSEDED"]},
    "owner": {"type": "string", "minLength": 1},
    "definition": {"type": "string", "minLength": 1},
    "grain": {"type": ["string", "null"]},
    "inputs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "outputs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audit_use", "semantic_promotion", "selector_or_release_mutation"],
      "properties": {
        "audit_use": {"enum": ["ALLOWED", "REFERENCE_ONLY", "DENIED"]},
        "semantic_promotion": {"enum": ["DENIED"]},
        "selector_or_release_mutation": {"enum": ["DENIED"]}
      }
    },
    "functional_class": {"type": ["string", "null"], "enum": [null, "STATE_CHANGE", "LEVEL_INTERACTION", "PERSISTENCE", "SEQUENCE_INSTABILITY", "CROSS_SCALE_CONTEXT", "COMPUTABILITY", "RESEARCH_SELECTION_ONLY"]},
    "required_axes": {"type": "array", "items": {"enum": ["LOCATION", "MOTION", "ORGANISATION", "INTERACTION", "QUALITY"]}, "uniqueItems": true},
    "required_history_bars": {"type": ["integer", "null"], "minimum": 0},
    "requires_parent": {"type": ["boolean", "null"]},
    "numerator": {"type": ["string", "null"]},
    "denominator": {"type": ["string", "null"]},
    "unit": {"type": ["string", "null"]},
    "zero_denominator": {"type": ["string", "null"], "enum": [null, "NOT_EVALUABLE", "ZERO"]},
    "reason_family": {"type": ["string", "null"], "enum": [null, "SOURCE", "PARENT", "AXIS", "HISTORY", "CONTINUITY", "CONFLICT", "CENSORING", "QUARANTINE", "SCOPE"]},
    "source_lineage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "role": {"enum": ["NORMATIVE", "IMPLEMENTATION_SOURCE", "REFERENCE", "FIXTURE"]},
          "symbol": {"type": ["string", "null"]}
        }
      }
    },
    "supersedes": {"type": ["string", "null"]}
  }
}
