{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://ovc.local/schemas/research_operations/p1cdi/p1cdi_bootstrap_v0_1.schema.json",
  "title":"P1CDI bootstrap census and completeness v0.1",
  "oneOf":[{"$ref":"#/$defs/Census"},{"$ref":"#/$defs/Completeness"}],
  "$defs":{
    "Ref":{"type":"string","minLength":1},"Sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "Subject":{"type":"object","required":["subject_id","owner","source_locator","source_sha256","source_generation","dmrp_conformance_class","visibility_state","currentness_state","migration_disposition"],"properties":{"subject_id":{"$ref":"#/$defs/Ref"},"owner":{"$ref":"#/$defs/Ref"},"source_locator":{"type":["string","null"]},"source_sha256":{"oneOf":[{"$ref":"#/$defs/Sha256"},{"type":"null"}]},"source_generation":{"type":["string","null"]},"dmrp_conformance_class":{"enum":["DMRP_CONFORMANT","LEGACY_PRE_DMRP_DISCOVERY","NOT_APPLICABLE","UNRESOLVED"]},"visibility_state":{"$ref":"#/$defs/Ref"},"currentness_state":{"enum":["CURRENT","HISTORICAL","STALE","UNRESOLVED","CONFLICT"]},"migration_disposition":{"enum":["PENDING","MIGRATED","EXACT_DUPLICATE","NOT_APPLICABLE","SOURCE_UNAVAILABLE","VISIBILITY_BLOCKED","SOURCE_INVALID","QUARANTINED"]}},"additionalProperties":false},
    "Census":{"type":"object","required":["record_type","schema_version","census_id","as_of_commit","subjects","expected_subject_count","silent_omission","reconstruction_from_summary","authority_effect"],"properties":{"record_type":{"const":"P1CDIBootstrapSourceCensusManifest"},"schema_version":{"const":"0.1"},"census_id":{"$ref":"#/$defs/Ref"},"as_of_commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},"subjects":{"type":"array","items":{"$ref":"#/$defs/Subject"},"uniqueItems":true},"expected_subject_count":{"type":"integer","minimum":0},"silent_omission":{"const":"FORBIDDEN"},"reconstruction_from_summary":{"const":"FORBIDDEN"},"authority_effect":{"const":"NONE"}},"additionalProperties":false},
    "Completeness":{"type":"object","required":["record_type","schema_version","manifest_id","census_ref","subjects","expected_subject_count","reconciled_subject_count","complete","authority_effect"],"properties":{"record_type":{"const":"BootstrapSourceCompletenessManifest"},"schema_version":{"const":"0.1"},"manifest_id":{"$ref":"#/$defs/Ref"},"census_ref":{"$ref":"#/$defs/Ref"},"subjects":{"type":"array","items":{"$ref":"#/$defs/Subject"},"uniqueItems":true},"expected_subject_count":{"type":"integer","minimum":0},"reconciled_subject_count":{"type":"integer","minimum":0},"complete":{"type":"boolean"},"authority_effect":{"const":"NONE"}},"additionalProperties":false}
  }
}
