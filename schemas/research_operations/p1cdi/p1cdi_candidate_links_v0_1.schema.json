{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://ovc.local/schemas/research_operations/p1cdi/p1cdi_candidate_links_v0_1.schema.json",
  "title":"P1CDI candidate-link records v0.1",
  "oneOf":[{"$ref":"#/$defs/Readiness"},{"$ref":"#/$defs/Derivation"},{"$ref":"#/$defs/Revision"},{"$ref":"#/$defs/Binding"},{"$ref":"#/$defs/DispositionBinding"}],
  "$defs":{
    "Ref":{"type":"string","minLength":1},
    "Base":{"type":"object","required":["record_type","schema_version","record_id","authority_effect","candidate_write"],"properties":{"record_type":{"type":"string"},"schema_version":{"const":"0.1"},"record_id":{"$ref":"#/$defs/Ref"},"authority_effect":{"const":"NONE"},"candidate_write":{"const":"DENIED"}}},
    "Readiness":{"allOf":[{"$ref":"#/$defs/Base"},{"type":"object","required":["generation_id","result","source_completeness_refs","reason_codes"],"properties":{"record_type":{"const":"P1ProposalReadinessAssessment"},"schema_version":{"const":"0.1"},"record_id":{"$ref":"#/$defs/Ref"},"authority_effect":{"const":"NONE"},"candidate_write":{"const":"DENIED"},"generation_id":{"$ref":"#/$defs/Ref"},"result":{"enum":["MECHANICAL_REVIEW_READY","NOT_READY","UNRESOLVED","BLOCKED"]},"source_completeness_refs":{"type":"array","items":{"$ref":"#/$defs/Ref"},"uniqueItems":true},"reason_codes":{"type":"array","items":{"$ref":"#/$defs/Ref"},"uniqueItems":true}},"additionalProperties":false}]},
    "Derivation":{"allOf":[{"$ref":"#/$defs/Base"},{"type":"object","required":["distinction_generation_refs","candidate_ref","relation"],"properties":{"record_type":{"const":"P1CandidateDerivationManifest"},"schema_version":{"const":"0.1"},"record_id":{"$ref":"#/$defs/Ref"},"authority_effect":{"const":"NONE"},"candidate_write":{"const":"DENIED"},"distinction_generation_refs":{"type":"array","items":{"$ref":"#/$defs/Ref"},"minItems":1,"uniqueItems":true},"candidate_ref":{"$ref":"#/$defs/Ref"},"relation":{"enum":["DIRECT_FORMALISATION_OF","REFINES_DISTINCTION","RESTRICTS_DISTINCTION","COMBINES_DISTINCTIONS","DERIVES_SEQUENCE_FROM","DERIVES_CROSS_SCALE_FROM","USES_AS_NEGATIVE_SPACE","USES_AS_DISCRIMINATOR","PROVENANCE_ONLY"]}},"additionalProperties":false}]},
    "Revision":{"allOf":[{"$ref":"#/$defs/Base"},{"type":"object","required":["candidate_ref","successor_candidate_ref","reason_source_ref"],"properties":{"record_type":{"const":"P1CandidateProposalRevision"},"schema_version":{"const":"0.1"},"record_id":{"$ref":"#/$defs/Ref"},"authority_effect":{"const":"NONE"},"candidate_write":{"const":"DENIED"},"candidate_ref":{"$ref":"#/$defs/Ref"},"successor_candidate_ref":{"$ref":"#/$defs/Ref"},"reason_source_ref":{"$ref":"#/$defs/Ref"}},"additionalProperties":false}]},
    "Binding":{"allOf":[{"$ref":"#/$defs/Base"},{"type":"object","required":["generation_id","candidate_ref","relation"],"properties":{"record_type":{"const":"P1DistinctionCandidateBinding"},"schema_version":{"const":"0.1"},"record_id":{"$ref":"#/$defs/Ref"},"authority_effect":{"const":"NONE"},"candidate_write":{"const":"DENIED"},"generation_id":{"$ref":"#/$defs/Ref"},"candidate_ref":{"$ref":"#/$defs/Ref"},"relation":{"$ref":"#/$defs/Ref"}},"additionalProperties":false}]},
    "DispositionBinding":{"allOf":[{"$ref":"#/$defs/Base"},{"type":"object","required":["candidate_ref","source_disposition_ref","projected_value"],"properties":{"record_type":{"const":"CandidateDispositionBinding"},"schema_version":{"const":"0.1"},"record_id":{"$ref":"#/$defs/Ref"},"authority_effect":{"const":"NONE"},"candidate_write":{"const":"DENIED"},"candidate_ref":{"$ref":"#/$defs/Ref"},"source_disposition_ref":{"$ref":"#/$defs/Ref"},"projected_value":{"$ref":"#/$defs/Ref"}},"additionalProperties":false}]}
  }
}
