{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://ovc.local/schemas/research_operations/p1cdi/p1cdi_demand_rccr_v0_1.schema.json",
  "title":"P1CDI demand and RCCR records v0.1",
  "oneOf":[{"$ref":"#/$defs/Demand"},{"$ref":"#/$defs/Eligibility"},{"$ref":"#/$defs/Referral"},{"$ref":"#/$defs/StackBinding"},{"$ref":"#/$defs/Recommendation"}],
  "$defs":{
    "Ref":{"type":"string","minLength":1},
    "DemandType":{"enum":["REPLICATION","INDEPENDENCE_ASSESSMENT","ALTERNATE_REPRESENTATION","ALTERNATE_METHOD","SENSITIVITY_CHALLENGE","TEMPORAL_STABILITY","CONTEXT_CHALLENGE","BOUNDARY_CHALLENGE","SEPARATION_CHALLENGE","DENOMINATOR_RESOLUTION","REPRODUCTION","CAPACITY_COMPLETION","ADVERSARIAL_REVIEW","CORRESPONDENCE_REVIEW","CANDIDATE_REVIEW","MISSING_INFORMATION","DATA_EXTENSION","SOURCE_REPLICATION","CROSS_INSTRUMENT_REPLICATION","CROSS_PROVIDER_REPLICATION","STACK_SUFFICIENCY_REVIEW"]},
    "Demand":{"type":"object","required":["record_type","schema_version","demand_id","generation_refs","demand_type","state","source_evidence_refs","required_information","blockers","authority_effect"],"properties":{"record_type":{"const":"P1DiscoveryDemand"},"schema_version":{"const":"0.1"},"demand_id":{"$ref":"#/$defs/Ref"},"generation_refs":{"type":"array","items":{"$ref":"#/$defs/Ref"},"minItems":1,"uniqueItems":true},"demand_type":{"$ref":"#/$defs/DemandType"},"state":{"enum":["OPEN","PLANNED","IN_PROGRESS","SATISFIED","PARTIALLY_SATISFIED","BLOCKED","DEFERRED","ABANDONED","SUPERSEDED","REOPENED"]},"source_evidence_refs":{"type":"array","items":{"$ref":"#/$defs/Ref"},"uniqueItems":true},"required_information":{"type":"array","items":{"$ref":"#/$defs/Ref"},"minItems":1,"uniqueItems":true},"blockers":{"type":"array","items":{"$ref":"#/$defs/Ref"},"uniqueItems":true},"authority_effect":{"const":"NONE"}},"additionalProperties":false},
    "Eligibility":{"type":"object","required":["record_type","schema_version","assessment_id","demand_id","current_stack_result","reason_codes","authority_effect"],"properties":{"record_type":{"const":"P1DemandEligibilityAssessment"},"schema_version":{"const":"0.1"},"assessment_id":{"$ref":"#/$defs/Ref"},"demand_id":{"$ref":"#/$defs/Ref"},"current_stack_result":{"enum":["RESEARCHABLE","NOT_RESEARCHABLE","UNRESOLVED","BLOCKED"]},"reason_codes":{"type":"array","items":{"$ref":"#/$defs/Ref"},"uniqueItems":true},"authority_effect":{"const":"NONE"}},"additionalProperties":false},
    "Referral":{"type":"object","required":["record_type","schema_version","referral_id","demand_id","question","required_information","source_frontier_ref","rccr_owner_ref","rccr_result_ref","authority_effect"],"properties":{"record_type":{"const":"P1RCCRReferral"},"schema_version":{"const":"0.1"},"referral_id":{"$ref":"#/$defs/Ref"},"demand_id":{"$ref":"#/$defs/Ref"},"question":{"$ref":"#/$defs/Ref"},"required_information":{"type":"array","items":{"$ref":"#/$defs/Ref"},"minItems":1},"source_frontier_ref":{"$ref":"#/$defs/Ref"},"rccr_owner_ref":{"$ref":"#/$defs/Ref"},"rccr_result_ref":{"type":["string","null"]},"authority_effect":{"const":"NONE"}},"additionalProperties":false},
    "StackBinding":{"type":"object","required":["record_type","schema_version","binding_id","demand_id","rccr_result_ref","capability_activation","authority_effect"],"properties":{"record_type":{"const":"P1StackSufficiencyBinding"},"schema_version":{"const":"0.1"},"binding_id":{"$ref":"#/$defs/Ref"},"demand_id":{"$ref":"#/$defs/Ref"},"rccr_result_ref":{"$ref":"#/$defs/Ref"},"capability_activation":{"const":"DENIED"},"authority_effect":{"const":"NONE"}},"additionalProperties":false},
    "Recommendation":{"type":"object","required":["record_type","schema_version","recommendation_id","demand_refs","reason_trace","route_class","actuation","write_capability","authority_effect"],"properties":{"record_type":{"const":"P1DiscoveryWorkRecommendation"},"schema_version":{"const":"0.1"},"recommendation_id":{"$ref":"#/$defs/Ref"},"demand_refs":{"type":"array","items":{"$ref":"#/$defs/Ref"},"minItems":1,"uniqueItems":true},"reason_trace":{"type":"array","items":{"$ref":"#/$defs/Ref"},"minItems":1},"route_class":{"const":"ADVISORY_ONLY"},"actuation":{"const":"DENIED"},"write_capability":{"const":"NONE"},"authority_effect":{"const":"NONE"}},"additionalProperties":false}
  }
}
