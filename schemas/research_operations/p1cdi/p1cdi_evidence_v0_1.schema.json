{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://ovc.local/schemas/research_operations/p1cdi/p1cdi_evidence_v0_1.schema.json",
  "title":"P1CDI evidence records v0.1",
  "oneOf":[{"$ref":"#/$defs/Frontier"},{"$ref":"#/$defs/Assessment"},{"$ref":"#/$defs/Vector"},{"$ref":"#/$defs/Contradiction"},{"$ref":"#/$defs/Replication"},{"$ref":"#/$defs/Challenge"},{"$ref":"#/$defs/NullBinding"}],
  "$defs":{
    "Ref":{"type":"string","minLength":1},
    "Base":{"type":"object","required":["record_type","schema_version","record_id","generation_id","source_refs","authority_effect"],"properties":{"record_type":{"type":"string"},"schema_version":{"const":"0.1"},"record_id":{"$ref":"#/$defs/Ref"},"generation_id":{"$ref":"#/$defs/Ref"},"source_refs":{"type":"array","items":{"$ref":"#/$defs/Ref"},"minItems":1,"uniqueItems":true},"authority_effect":{"const":"NONE"}}},
    "Frontier":{"allOf":[{"$ref":"#/$defs/Base"},{"type":"object","properties":{"record_type":{"const":"P1EvidenceFrontierManifest"},"schema_version":{"const":"0.1"},"record_id":{"$ref":"#/$defs/Ref"},"generation_id":{"$ref":"#/$defs/Ref"},"source_refs":{"type":"array","items":{"$ref":"#/$defs/Ref"},"minItems":1,"uniqueItems":true},"frontier_first_valid_time":{"type":"string","format":"date-time"},"authority_effect":{"const":"NONE"}},"required":["frontier_first_valid_time"],"additionalProperties":false}]},
    "Assessment":{"allOf":[{"$ref":"#/$defs/Base"},{"type":"object","properties":{"record_type":{"const":"P1DistinctionEvidenceAssessment"},"schema_version":{"const":"0.1"},"record_id":{"$ref":"#/$defs/Ref"},"generation_id":{"$ref":"#/$defs/Ref"},"source_refs":{"type":"array","items":{"$ref":"#/$defs/Ref"},"minItems":1,"uniqueItems":true},"rule_profile_ref":{"$ref":"#/$defs/Ref"},"scientific_disposition_ref":{"type":["string","null"]},"scientific_assessment_state":{"enum":["SOURCE_OWNER_REFERENCE","UNRESOLVED"]},"authority_effect":{"const":"NONE"}},"required":["rule_profile_ref","scientific_disposition_ref","scientific_assessment_state"],"additionalProperties":false}]},
    "Vector":{"allOf":[{"$ref":"#/$defs/Base"},{"type":"object","properties":{"record_type":{"const":"P1DistinctionEvidenceStateVector"},"schema_version":{"const":"0.1"},"record_id":{"$ref":"#/$defs/Ref"},"generation_id":{"$ref":"#/$defs/Ref"},"source_refs":{"type":"array","items":{"$ref":"#/$defs/Ref"},"minItems":1,"uniqueItems":true},"denominator":{"enum":["COMPLETE","COMPLETE_WITH_CENSORING","PARTIAL_DECLARED","NOT_EVALUABLE","OWNER_UNRESOLVED","CAPACITY_INCOMPLETE"]},"recurrence":{"enum":["NOT_TESTED","PRESENT","ABSENT","NOT_EVALUABLE","CAPACITY_INCOMPLETE"]},"dependence":{"enum":["INDEPENDENCE_UNKNOWN","DEPENDENT","INDEPENDENT_AFFIRMATIVE","UNRESOLVED"]},"separation":{"enum":["PRESENT","WEAK","FAILED","AMBIGUOUS","NOT_COMPARABLE"]},"integrity":{"enum":["PASS","WARN","UNRESOLVED","QUARANTINED","SOURCE_CONFLICT"]},"other_planes":{"type":"object"},"authority_effect":{"const":"NONE"}},"required":["denominator","recurrence","dependence","separation","integrity","other_planes"],"additionalProperties":false}]},
    "Contradiction":{"allOf":[{"$ref":"#/$defs/Base"},{"type":"object","properties":{"record_type":{"const":"P1DistinctionContradictionRecord"},"schema_version":{"const":"0.1"},"record_id":{"$ref":"#/$defs/Ref"},"generation_id":{"$ref":"#/$defs/Ref"},"source_refs":{"type":"array","items":{"$ref":"#/$defs/Ref"},"minItems":1,"uniqueItems":true},"contradiction_type":{"$ref":"#/$defs/Ref"},"authority_effect":{"const":"NONE"}},"required":["contradiction_type"],"additionalProperties":false}]},
    "Replication":{"allOf":[{"$ref":"#/$defs/Base"},{"type":"object","properties":{"record_type":{"const":"P1ReplicationOutcomeRecord"},"schema_version":{"const":"0.1"},"record_id":{"$ref":"#/$defs/Ref"},"generation_id":{"$ref":"#/$defs/Ref"},"source_refs":{"type":"array","items":{"$ref":"#/$defs/Ref"},"minItems":1,"uniqueItems":true},"replication_kind":{"enum":["REPRODUCTION","SCIENTIFIC_REPLICATION"]},"outcome":{"enum":["PRESENT","ABSENT","FAILED","NOT_EVALUABLE","UNRESOLVED"]},"authority_effect":{"const":"NONE"}},"required":["replication_kind","outcome"],"additionalProperties":false}]},
    "Challenge":{"allOf":[{"$ref":"#/$defs/Base"},{"type":"object","properties":{"record_type":{"const":"P1MethodChallengeResult"},"schema_version":{"const":"0.1"},"record_id":{"$ref":"#/$defs/Ref"},"generation_id":{"$ref":"#/$defs/Ref"},"source_refs":{"type":"array","items":{"$ref":"#/$defs/Ref"},"minItems":1,"uniqueItems":true},"challenge_class":{"$ref":"#/$defs/Ref"},"result":{"$ref":"#/$defs/Ref"},"authority_effect":{"const":"NONE"}},"required":["challenge_class","result"],"additionalProperties":false}]},
    "NullBinding":{"allOf":[{"$ref":"#/$defs/Base"},{"type":"object","properties":{"record_type":{"const":"P1NullEvidenceBinding"},"schema_version":{"const":"0.1"},"record_id":{"$ref":"#/$defs/Ref"},"generation_id":{"$ref":"#/$defs/Ref"},"source_refs":{"type":"array","items":{"$ref":"#/$defs/Ref"},"minItems":1,"uniqueItems":true},"null_class":{"enum":["NULL","RESIDUAL","CENSORED","CAPACITY_INCOMPLETE","AMBIGUOUS"]},"authority_effect":{"const":"NONE"}},"required":["null_class"],"additionalProperties":false}]}
  }
}
