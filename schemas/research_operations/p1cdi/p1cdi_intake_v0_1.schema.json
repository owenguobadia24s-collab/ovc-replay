{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://ovc.local/schemas/research_operations/p1cdi/p1cdi_intake_v0_1.schema.json",
  "title":"P1CDI intake and cycle records v0.1",
  "oneOf":[{"$ref":"#/$defs/IntakeEnvelope"},{"$ref":"#/$defs/CycleRecord"},{"$ref":"#/$defs/ClosureManifest"}],
  "$defs":{
    "Ref":{"type":"string","minLength":1},"Sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "IntakeClass":{"enum":["DISCOVERY_RESULT","STRUCTURAL_CORE","CLOSURE_CLASS","EVIDENCE_DOSSIER","P1_DISPOSITION","PATH1_CANDIDATE_PROPOSAL","NULL_FINDING","RESIDUAL_FINDING","CONTRADICTION","FAILED_REPLICATION","REPLICATION_RESULT","ADVERSARIAL_REVIEW","STACK_SUFFICIENCY_FINDING","METHOD_GAP_FINDING","MISSING_INFORMATION_FINDING","POPULATION_INTEGRITY","DENOMINATOR","DEPENDENCE","CAPACITY","REPRODUCIBILITY","CORRECTION","QUARANTINE_RECORD","SUPERSESSION_RECORD"]},
    "IntakeState":{"enum":["PENDING_RESOLUTION","ADMITTED_NEW_DISTINCTION","ADMITTED_EXISTING_DISTINCTION_EVIDENCE","ADMITTED_NON_DISTINCTION_FINDING","ADMITTED_CORRECTION","DUPLICATE_EXACT","CORRESPONDENCE_REVIEW_REQUIRED","SOURCE_CONFLICT","VISIBILITY_BLOCKED","NOT_ADMISSIBLE","QUARANTINED"]},
    "IntakeEnvelope":{"type":"object","required":["record_type","schema_version","envelope_id","source_ref","source_sha256","source_owner","source_first_valid_time","received_time","inventory_first_valid_time","intake_class","intake_state","visibility_class","reason_codes","authority_effect"],"properties":{"record_type":{"const":"P1DiscoveryIntakeEnvelope"},"schema_version":{"const":"0.1"},"envelope_id":{"$ref":"#/$defs/Ref"},"source_ref":{"$ref":"#/$defs/Ref"},"source_sha256":{"$ref":"#/$defs/Sha256"},"source_owner":{"$ref":"#/$defs/Ref"},"source_first_valid_time":{"type":"string","format":"date-time"},"received_time":{"type":"string","format":"date-time"},"inventory_first_valid_time":{"type":"string","format":"date-time"},"intake_class":{"$ref":"#/$defs/IntakeClass"},"intake_state":{"$ref":"#/$defs/IntakeState"},"visibility_class":{"$ref":"#/$defs/Ref"},"reason_codes":{"type":"array","items":{"$ref":"#/$defs/Ref"},"uniqueItems":true},"authority_effect":{"const":"NONE"}},"additionalProperties":false},
    "CycleRecord":{"type":"object","required":["record_type","schema_version","cycle_record_id","source_cycle_ref","source_frontier_ref","inventory_item_refs","zero_distinction_cycle","authority_effect"],"properties":{"record_type":{"const":"P1EvidenceCycleInventoryRecord"},"schema_version":{"const":"0.1"},"cycle_record_id":{"$ref":"#/$defs/Ref"},"source_cycle_ref":{"$ref":"#/$defs/Ref"},"source_frontier_ref":{"$ref":"#/$defs/Ref"},"inventory_item_refs":{"type":"array","items":{"$ref":"#/$defs/Ref"},"uniqueItems":true},"zero_distinction_cycle":{"type":"boolean"},"authority_effect":{"const":"NONE"}},"additionalProperties":false},
    "ClosureManifest":{"type":"object","required":["record_type","schema_version","closure_id","cycle_record_id","expected_subject_count","reconciled_subject_count","complete","reason_codes","authority_effect"],"properties":{"record_type":{"const":"P1CycleInventoryClosureManifest"},"schema_version":{"const":"0.1"},"closure_id":{"$ref":"#/$defs/Ref"},"cycle_record_id":{"$ref":"#/$defs/Ref"},"expected_subject_count":{"type":"integer","minimum":0},"reconciled_subject_count":{"type":"integer","minimum":0},"complete":{"type":"boolean"},"reason_codes":{"type":"array","items":{"$ref":"#/$defs/Ref"},"uniqueItems":true},"authority_effect":{"const":"NONE"}},"additionalProperties":false}
  }
}
