{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://ovc.local/schemas/research_operations/p1cdi/p1cdi_lifecycle_currentness_v0_1.schema.json",
  "title":"P1CDI lifecycle and currentness records v0.1",
  "oneOf":[{"$ref":"#/$defs/LifecycleEvent"},{"$ref":"#/$defs/SourceFrontier"},{"$ref":"#/$defs/Currentness"}],
  "$defs":{
    "Ref":{"type":"string","minLength":1},"Sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "LifecycleEvent":{"type":"object","required":["record_type","schema_version","event_id","generation_id","activity_state","effective_time","source_scientific_disposition_ref","authority_effect"],"properties":{"record_type":{"const":"P1DistinctionLifecycleEvent"},"schema_version":{"const":"0.1"},"event_id":{"$ref":"#/$defs/Ref"},"generation_id":{"$ref":"#/$defs/Ref"},"activity_state":{"enum":["ACTIVE_RESEARCH","DORMANT","REOPENED","HISTORICAL","QUARANTINED"]},"effective_time":{"type":"string","format":"date-time"},"source_scientific_disposition_ref":{"type":["string","null"]},"authority_effect":{"const":"NONE"}},"additionalProperties":false},
    "SourceFrontier":{
      "type":"object",
      "required":["record_type","schema_version","frontier_id","resolved_at","required_owners","owner_entries","missing_required_owners","duplicate_required_owners","completeness_state","reason_codes","frontier_sha256","authority_effect"],
      "properties":{
        "record_type":{"const":"SourceFrontierManifest"},
        "schema_version":{"const":"0.1"},
        "frontier_id":{"$ref":"#/$defs/Ref"},
        "resolved_at":{"type":"string","format":"date-time"},
        "required_owners":{"type":"array","minItems":7,"maxItems":7,"uniqueItems":true,"items":{"$ref":"#/$defs/Ref"}},
        "owner_entries":{"type":"array","minItems":1,"items":{"type":"object","required":["owner","source_ref","generation_ref","source_sha256","resolution_state"],"properties":{"owner":{"$ref":"#/$defs/Ref"},"source_ref":{"$ref":"#/$defs/Ref"},"generation_ref":{"type":["string","null"]},"source_sha256":{"$ref":"#/$defs/Sha256"},"resolution_state":{"enum":["RESOLVED","UNRESOLVED","CONFLICT","UNAVAILABLE"]}},"additionalProperties":false}},
        "missing_required_owners":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/Ref"}},
        "duplicate_required_owners":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/Ref"}},
        "completeness_state":{"enum":["COMPLETE","UNRESOLVED","CONFLICT"]},
        "reason_codes":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/Ref"}},
        "frontier_sha256":{"$ref":"#/$defs/Sha256"},
        "authority_effect":{"const":"NONE"}
      },
      "additionalProperties":false
    },
    "Currentness":{"type":"object","required":["record_type","schema_version","resolution_id","generation_id","prebuild_frontier_ref","prepublish_frontier_ref","frontiers_equal","currentness","reason_codes","decision_bearing","authority_effect"],"properties":{"record_type":{"const":"CurrentnessResolutionRecord"},"schema_version":{"const":"0.1"},"resolution_id":{"$ref":"#/$defs/Ref"},"generation_id":{"$ref":"#/$defs/Ref"},"prebuild_frontier_ref":{"$ref":"#/$defs/Ref"},"prepublish_frontier_ref":{"$ref":"#/$defs/Ref"},"frontiers_equal":{"type":"boolean"},"currentness":{"enum":["CURRENT","HISTORICAL","STALE","UNRESOLVED","CONFLICT"]},"reason_codes":{"type":"array","items":{"$ref":"#/$defs/Ref"},"uniqueItems":true},"decision_bearing":{"const":false},"authority_effect":{"const":"NONE"}},"additionalProperties":false}
  }
}
