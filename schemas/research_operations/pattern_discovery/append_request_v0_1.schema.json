{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ovc.local/schemas/research_operations/pattern_discovery/append_request_v0_1.schema.json",
  "title": "Pattern Discovery Evidence AppendRequest",
  "type": "object",
  "required": ["append_request_id", "operator_id", "session_id", "nonce", "expected_sequence_number", "candidate_window_id", "candidate_fingerprint_hash", "source_release_ids", "source_record_ids", "admissible_cutoff", "record_class", "record_body_hash", "requested_at", "ui_build_hash"],
  "properties": {
    "append_request_id": {"type": "string", "minLength": 1},
    "operator_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "nonce": {"type": "string", "minLength": 16},
    "expected_sequence_number": {"type": "integer", "minimum": 0},
    "candidate_window_id": {"type": "string", "minLength": 1},
    "candidate_fingerprint_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_release_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "source_record_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "admissible_cutoff": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "record_class": {"enum": ["STATE_FIDELITY_REVIEW", "BOUNDARY_CONFLICT_CASE", "ANOMALY", "INCIDENT", "BOUNDED_RESEARCH_QUESTION"]},
    "record_body_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requested_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "ui_build_hash": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "operation_mode": {"enum": ["LIVE_PROSPECTIVE", "TIME_GATED_REPLAY", "NON_EVIDENTIARY_REPLAY"]}
  },
  "additionalProperties": false
}
