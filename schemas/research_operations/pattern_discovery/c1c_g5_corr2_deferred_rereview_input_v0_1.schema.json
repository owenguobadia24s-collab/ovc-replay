{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ovc-c1c-g5-corr2-deferred-rereview-input/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "packet_id", "pilot_run_id", "operator_id", "reviewed_at_utc", "decisions"],
  "properties": {
    "schema": {"const": "ovc-c1c-g5-corr2-deferred-rereview-input/v1"},
    "packet_id": {"const": "C1C-G5-CORR2"},
    "pilot_run_id": {"const": "PD.PILOT.RUN.96c16f11717e787f971851ee"},
    "operator_id": {"const": "OVC.OPERATOR.PRIMARY.LOCAL.V1"},
    "reviewed_at_utc": {"type": "string", "pattern": "Z$", "minLength": 2},
    "decisions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_window_id", "source_finding_code", "review_disposition", "closure_code", "decision_basis", "closure_criteria", "notes", "evidence_references"],
        "properties": {
          "candidate_window_id": {"enum": ["PDPILOT-CANDIDATE-4f41e21b6cd075e0fdbc40e4", "PDPILOT-CANDIDATE-bab63b935155e4d9033aed81"]},
          "source_finding_code": {"enum": ["PD-DEFER-REVIEW-EVIDENCE-INCOMPLETE-001", "PD-DEFER-STRUCTURAL-COMPARISON-PENDING-002"]},
          "review_disposition": {"enum": ["WORKFLOW_ACCEPTED", "REJECT_PILOT_OBJECT"]},
          "closure_code": {"type": "string", "pattern": "^PD-CORR2-", "minLength": 10},
          "decision_basis": {"type": "string", "minLength": 1},
          "closure_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "notes": {"type": "string", "minLength": 1},
          "evidence_references": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
