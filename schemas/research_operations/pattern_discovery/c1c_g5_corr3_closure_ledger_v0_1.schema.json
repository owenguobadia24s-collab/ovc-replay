{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ovc.local/schemas/research_operations/pattern_discovery/c1c_g5_corr3_closure_ledger_v0_1.schema.json",
  "title": "C1C-G5-CORR3 closure ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "packet_id", "gate_id", "pilot_run_id", "source_corr3_review_receipt_file_sha256",
    "candidate_window_id", "prior_finding_code", "final_disposition", "resolution_status",
    "remaining_deferred_object_count", "preserved_rejected_object_decision_sha256",
    "preserved_non_deferred_decisions_sha256", "second_machine_replay_performed", "pilot_only",
    "promotion_eligibility", "canonical_append", "status", "ledger_sha256"
  ],
  "properties": {
    "schema": {"const": "ovc-c1c-g5-corr3-closure-ledger/v1"},
    "packet_id": {"const": "C1C-G5-CORR3"},
    "gate_id": {"const": "C1C-G5-CORRECTIVE-PILOT-REVIEW"},
    "pilot_run_id": {"const": "PD.PILOT.RUN.96c16f11717e787f971851ee"},
    "source_corr3_review_receipt_file_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_window_id": {"const": "PDPILOT-CANDIDATE-bab63b935155e4d9033aed81"},
    "prior_finding_code": {"const": "PD-DEFER-CORR2-STRUCTURAL-COMPARISON-INCOMPLETE-001"},
    "final_disposition": {"enum": ["WORKFLOW_ACCEPTED", "DEFER_PILOT_OBJECT", "REJECT_PILOT_OBJECT"]},
    "resolution_status": {"enum": ["OPEN_DEFERRED", "CLOSED_BY_OPERATOR_REREVIEW"]},
    "remaining_deferred_object_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "preserved_rejected_object_decision_sha256": {"$ref": "#/$defs/sha256"},
    "preserved_non_deferred_decisions_sha256": {"$ref": "#/$defs/sha256"},
    "second_machine_replay_performed": {"const": false},
    "pilot_only": {"const": true},
    "promotion_eligibility": {"const": "NON_PROMOTABLE"},
    "canonical_append": {"const": "DENIED"},
    "status": {"enum": ["CORR3_REVIEW_COMPLETE_REMAINS_DEFERRED", "CORR3_REVIEW_COMPLETE_NO_DEFERRED_OBJECTS"]},
    "ledger_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
