{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ovc.local/schemas/research_operations/pattern_discovery/pd_g4b_pilot_discovery_gate_state_v0_1.schema.json",
  "title": "PD-G4B Pilot Discovery Amendment Gate State v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "gate_id",
    "gate_status",
    "decision_authority",
    "operator_approval_required",
    "research_role",
    "operation_mode",
    "source_slice_id",
    "compute_run_id",
    "source_binding_id",
    "signed_replay_acceptance_id",
    "signing_binding_id",
    "pilot_only",
    "promotion_eligibility",
    "canonical_discovery_population",
    "next_gate",
    "retained_prohibitions"
  ],
  "properties": {
    "schema": {"const": "ovc-pd-g4b-pilot-discovery-gate-state/v1"},
    "gate_id": {"const": "PD-G4B"},
    "gate_status": {"enum": ["GATE_READY", "APPROVED", "DEFERRED", "BLOCKED", "QUARANTINED", "SUPERSEDED", "COMPLETED"]},
    "decision_authority": {"const": "OPERATOR"},
    "operator_approval_required": {"type": "boolean"},
    "allowed_decisions": {
      "type": "array",
      "const": ["PASS", "DEFER", "BLOCK", "QUARANTINE", "SUPERSEDE"]
    },
    "research_role": {"const": "PILOT_DISCOVERY"},
    "operation_mode": {"const": "TIME_GATED_REPLAY"},
    "source_slice_id": {"const": "RPS.DUKASCOPY.GBPUSD.20260622_20260625.v1"},
    "source_coverage_state": {"const": "GAPPED"},
    "compute_run_id": {"const": "RPS.RUN.7aeb551335d766ee3bf503e6"},
    "source_binding_id": {"const": "RPS.BINDING.32fb3003efa072916c11e907"},
    "signed_replay_acceptance_id": {"const": "RPS.REPLAY-ACCEPT.0844eddf74e144ced487cc48"},
    "signing_binding_id": {"const": "RPS.SIGNING.50092c28981fef08f53a6cb5"},
    "operator_id": {"const": "OVC.OPERATOR.PRIMARY.LOCAL.V1"},
    "pilot_only": {"const": true},
    "promotion_eligibility": {"const": "NON_PROMOTABLE"},
    "canonical_discovery_population": {"const": false},
    "canonical_append": {"const": "DENIED"},
    "pilot_signed_evidence_capture": {"const": "OPERATOR_SIGNED_PILOT_NAMESPACE_ONLY"},
    "live_prospective_relabelling": {"const": "DENIED"},
    "identity_reset_before_canonical": {"const": "REQUIRED"},
    "rps_g4a_status": {"const": "SUPERSEDED_FOR_PILOT_DISCOVERY"},
    "future_live_gate": {"const": "RPS-LIVE-G1"},
    "next_gate": {"const": "PD-G5P"},
    "retained_prohibitions": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "decision_record": {"type": ["string", "null"]},
    "qa_packet": {"type": "string"},
    "gate_packet": {"type": "string"},
    "rollback": {"type": "string"}
  }
}
