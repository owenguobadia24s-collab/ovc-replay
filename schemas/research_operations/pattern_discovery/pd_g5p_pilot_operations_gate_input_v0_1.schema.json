{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ovc.local/schemas/research_operations/pattern_discovery/pd_g5p_pilot_operations_gate_input_v0_1.schema.json",
  "title": "PD-G5P Pilot Operations Gate Input v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "gate_id", "plan_id", "pilot_run_id", "pilot_namespace", "source_slice_id",
    "compute_run_id", "source_binding_id", "signed_replay_acceptance_id", "signing_binding_id",
    "operator_id", "pilot_output_manifest_sha256", "derived_bundle_sha256",
    "deterministic_rerun_match", "operator_review_complete", "defect_count",
    "contract_changes_required", "signed_pilot_evidence_inventory_file_sha256", "pilot_only",
    "promotion_eligibility", "canonical_discovery_population", "canonical_append",
    "live_prospective_relabelling", "identity_reset_before_canonical",
    "operator_approval_required", "allowed_decisions", "status"
  ],
  "properties": {
    "schema": {"const": "ovc-pd-g5p-pilot-operations-gate-input/v1"},
    "gate_id": {"const": "PD-G5P"},
    "plan_id": {"const": "OVC-C2-REAL-PROSPECTIVE-SOURCE-PD-WP5-ENABLEMENT-PLAN-0.1"},
    "pilot_run_id": {"type": "string", "pattern": "^PD\\.PILOT\\.RUN\\.[0-9a-f]{24}$"},
    "pilot_namespace": {"const": "PD.PILOT.GBPUSD.20260622_20260625.v1"},
    "source_slice_id": {"const": "RPS.DUKASCOPY.GBPUSD.20260622_20260625.v1"},
    "compute_run_id": {"const": "RPS.RUN.7aeb551335d766ee3bf503e6"},
    "source_binding_id": {"const": "RPS.BINDING.32fb3003efa072916c11e907"},
    "signed_replay_acceptance_id": {"const": "RPS.REPLAY-ACCEPT.0844eddf74e144ced487cc48"},
    "signing_binding_id": {"const": "RPS.SIGNING.50092c28981fef08f53a6cb5"},
    "operator_id": {"const": "OVC.OPERATOR.PRIMARY.LOCAL.V1"},
    "pilot_output_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "derived_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "deterministic_rerun_match": {"const": true},
    "operator_review_complete": {"const": true},
    "defect_count": {"type": "integer", "minimum": 0},
    "contract_changes_required": {"type": "boolean"},
    "signed_pilot_evidence_inventory_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pilot_only": {"const": true},
    "promotion_eligibility": {"const": "NON_PROMOTABLE"},
    "canonical_discovery_population": {"const": false},
    "canonical_append": {"const": "DENIED"},
    "live_prospective_relabelling": {"const": "DENIED"},
    "identity_reset_before_canonical": {"const": "REQUIRED"},
    "operator_approval_required": {"const": true},
    "allowed_decisions": {"const": ["PASS", "DEFER", "BLOCK", "QUARANTINE", "SUPERSEDE"]},
    "status": {"const": "PD_G5P_EVIDENCE_CANDIDATE"}
  }
}
