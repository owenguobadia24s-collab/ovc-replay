{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ovc-pd-june-2026-review-assessment/v1",
  "title": "OVC PD June 2026 Review Assessment",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "programme_id",
    "packet_id",
    "baseline_commit",
    "operator_boundary",
    "source_evidence",
    "machine_operation",
    "initial_v2_operator_review",
    "corrective_review_chain",
    "what_went_wrong",
    "reliability_dimensions",
    "overall_answer",
    "improvement_priorities",
    "missing_evidence_for_claim_level_assurance",
    "next_packet",
    "authority"
  ],
  "properties": {
    "schema": {"const": "ovc-pd-june-2026-review-assessment/v1"},
    "programme_id": {"const": "OVC-PD-JUNE-2026-OPERATOR-REVIEW-AND-MARKET-DESCRIPTION-ASSURANCE.v0.1"},
    "packet_id": {"const": "PD-JUNE-RA1"},
    "baseline_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "operator_boundary": {
      "type": "object",
      "required": ["canonical_2021_2023_discovery", "second_june_replay", "assessment_scope"]
    },
    "source_evidence": {
      "type": "object",
      "required": ["source_slice_id", "coverage_state", "pilot_v1_run_id", "pilot_v2_run_id", "deterministic_rerun_match", "signed_hash_chain_verified"]
    },
    "machine_operation": {
      "type": "object",
      "required": ["c2_states", "transitions", "trigger_events", "candidates", "queue_promoted", "queue_suppressed", "verdict"]
    },
    "initial_v2_operator_review": {
      "type": "object",
      "required": ["decision_count", "distribution", "clean_acceptance_rate", "qualified_or_nonaccepted_rate", "verdict"]
    },
    "corrective_review_chain": {
      "type": "object",
      "required": ["workflow_and_ui_findings", "corr2_results", "remaining_deferred_object_count", "verdict"]
    },
    "what_went_wrong": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "finding", "impact"]
      }
    },
    "reliability_dimensions": {
      "type": "object",
      "required": [
        "computational_reproducibility",
        "lineage_and_evidence_integrity",
        "review_workflow_reliability",
        "internal_structural_consistency",
        "external_market_description_validity",
        "population_level_consistency"
      ]
    },
    "overall_answer": {
      "type": "object",
      "required": ["question", "verdict", "statement"],
      "properties": {
        "verdict": {"const": "NOT_ESTABLISHED"}
      }
    },
    "improvement_priorities": {"type": "array", "minItems": 1},
    "missing_evidence_for_claim_level_assurance": {"type": "array", "minItems": 1},
    "next_packet": {
      "type": "object",
      "required": ["packet_id", "status", "scope", "canonical_2021_2023_discovery", "second_replay"]
    },
    "authority": {
      "type": "object",
      "required": [
        "canonical_discovery_processing",
        "canonical_append",
        "provider_intake",
        "machine_replay",
        "trigger_or_model_change",
        "semantic_or_candidate_promotion",
        "selector_or_release_mutation",
        "r2_publication",
        "validation_consumption",
        "probability",
        "risk",
        "exposure",
        "trading",
        "execution",
        "agent_write"
      ]
    }
  }
}
