{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ovc://schemas/research_operations/pattern_discovery/pd_june_mdr_corr1_evidence_assurance_v0_1",
  "title": "PD-JUNE-MDR-CORR1 evidence assurance records",
  "type": "object",
  "required": ["schema", "programme_id", "packet_id"],
  "properties": {
    "schema": {"type": "string", "minLength": 1},
    "programme_id": {
      "const": "OVC-PD-JUNE-2026-OPERATOR-REVIEW-AND-MARKET-DESCRIPTION-ASSURANCE.v0.1"
    },
    "packet_id": {"const": "PD-JUNE-MDR-CORR1"},
    "status": {"type": "string"},
    "market_description_verdict": {
      "enum": ["NOT_ESTABLISHED", "SUPPORTED", "PARTIAL", "CONTRADICTED", "NOT_EVALUATED"]
    },
    "authority": {"type": "object"},
    "ledger": {
      "type": "object",
      "properties": {
        "record_count": {"type": "integer", "minimum": 0},
        "uncompressed_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "compressed_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "additionalProperties": true
}
