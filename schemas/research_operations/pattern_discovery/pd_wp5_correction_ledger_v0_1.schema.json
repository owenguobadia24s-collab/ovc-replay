{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ovc.local/schemas/research_operations/pattern_discovery/pd_wp5_correction_ledger_v0_1.schema.json",
  "title": "PD-WP5 CORR1 Correction Ledger v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "packet_id",
    "gate_id",
    "pilot_run_id",
    "pilot_namespace",
    "source_review_receipt_file_sha256",
    "source_defect_ledger_file_sha256",
    "entries",
    "entry_count",
    "correction_scope",
    "second_pilot_replay_recommendation",
    "second_pilot_replay_authorised",
    "canonical_discovery_authorised",
    "status",
    "ledger_sha256"
  ],
  "properties": {
    "schema": {"const": "ovc-pd-wp5-correction-ledger/v1"},
    "packet_id": {"const": "PD-WP5-CORR1"},
    "gate_id": {"const": "PD-G5P"},
    "pilot_run_id": {"const": "PD.PILOT.RUN.0cc5a59ca751583f3e50091c"},
    "pilot_namespace": {"const": "PD.PILOT.GBPUSD.20260622_20260625.v1"},
    "source_review_receipt_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_defect_ledger_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entries": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "candidate_window_id",
          "review_disposition",
          "finding_code",
          "affected_component",
          "actual_behavior",
          "expected_behavior",
          "evidence_references",
          "acceptance_test_ids"
        ],
        "properties": {
          "candidate_window_id": {"type": "string", "pattern": "^PDPILOT-CANDIDATE-[0-9a-f]{24}$"},
          "review_disposition": {"enum": ["FLAG_WORKFLOW_DEFECT", "FLAG_UI_FRICTION", "DEFER_PILOT_OBJECT", "REJECT_PILOT_OBJECT"]},
          "finding_code": {"type": "string", "pattern": "^PD-(WF|UI|DEFER|REJECT)-[A-Z0-9-]+$"},
          "affected_component": {"type": "string", "minLength": 1},
          "affected_console_surface": {"type": "string", "minLength": 1},
          "actual_behavior": {"type": "string", "minLength": 1},
          "expected_behavior": {"type": "string", "minLength": 1},
          "reproduction_steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "resolution_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "next_review_condition": {"type": "string", "minLength": 1},
          "structural_basis": {"type": "string", "minLength": 1},
          "evidence_references": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "acceptance_test_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^PD-CORR1-[A-Z0-9-]+$"}}
        },
        "additionalProperties": false
      }
    },
    "entry_count": {"const": 5},
    "correction_scope": {"const": "VERSIONED_REVIEW_VALIDATION_AND_READ_ONLY_PRESENTATION_ONLY"},
    "second_pilot_replay_recommendation": {"const": "NOT_REQUIRED"},
    "second_pilot_replay_authorised": {"const": false},
    "canonical_discovery_authorised": {"const": false},
    "status": {"const": "CORRECTION_SPECIFICATION_COMPLETE"},
    "ledger_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
