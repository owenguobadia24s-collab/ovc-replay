{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ovc.local/schemas/research_operations/pattern_discovery/pd_wp5_pilot_review_input_v0_2.schema.json",
  "title": "PD-WP5 Structured Pilot Review Input v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "pilot_run_id", "operator_id", "reviewed_at_utc", "decisions"],
  "properties": {
    "schema": {"const": "ovc-pd-wp5-pilot-review-input/v2"},
    "pilot_run_id": {"type": "string", "pattern": "^PD\\.PILOT\\.RUN\\.[0-9A-Za-z.-]+$"},
    "operator_id": {"const": "OVC.OPERATOR.PRIMARY.LOCAL.V1"},
    "reviewed_at_utc": {"type": "string", "pattern": "Z$"},
    "decisions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/decision"}
    }
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "baseDecision": {
      "type": "object",
      "required": [
        "candidate_window_id",
        "review_disposition",
        "notes",
        "evidence_references",
        "ui_friction_codes"
      ],
      "properties": {
        "candidate_window_id": {"type": "string", "pattern": "^PDPILOT-CANDIDATE-[0-9a-f]{24}$"},
        "review_disposition": {
          "enum": [
            "WORKFLOW_ACCEPTED",
            "FLAG_WORKFLOW_DEFECT",
            "FLAG_UI_FRICTION",
            "DEFER_PILOT_OBJECT",
            "REJECT_PILOT_OBJECT"
          ]
        },
        "notes": {"$ref": "#/$defs/nonEmptyString"},
        "evidence_references": {"$ref": "#/$defs/nonEmptyStringArray"},
        "ui_friction_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^PD-UI-[A-Z0-9-]+$"}
        },
        "finding_code": {"$ref": "#/$defs/nonEmptyString"},
        "affected_component": {"$ref": "#/$defs/nonEmptyString"},
        "affected_console_surface": {"$ref": "#/$defs/nonEmptyString"},
        "actual_behavior": {"$ref": "#/$defs/nonEmptyString"},
        "expected_behavior": {"$ref": "#/$defs/nonEmptyString"},
        "reproduction_steps": {"$ref": "#/$defs/nonEmptyStringArray"},
        "acceptance_criteria": {"$ref": "#/$defs/nonEmptyStringArray"},
        "acceptance_basis": {"$ref": "#/$defs/nonEmptyString"},
        "resolution_criteria": {"$ref": "#/$defs/nonEmptyStringArray"},
        "next_review_condition": {"$ref": "#/$defs/nonEmptyString"},
        "structural_basis": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "decision": {
      "allOf": [
        {"$ref": "#/$defs/baseDecision"},
        {
          "oneOf": [
            {
              "properties": {"review_disposition": {"const": "WORKFLOW_ACCEPTED"}},
              "required": ["acceptance_basis", "acceptance_criteria"]
            },
            {
              "properties": {
                "review_disposition": {"const": "FLAG_WORKFLOW_DEFECT"},
                "finding_code": {"type": "string", "pattern": "^PD-WF-[A-Z0-9-]+$"}
              },
              "required": [
                "finding_code",
                "affected_component",
                "actual_behavior",
                "expected_behavior",
                "reproduction_steps",
                "acceptance_criteria"
              ]
            },
            {
              "properties": {
                "review_disposition": {"const": "FLAG_UI_FRICTION"},
                "finding_code": {"type": "string", "pattern": "^PD-UI-[A-Z0-9-]+$"},
                "ui_friction_codes": {"$ref": "#/$defs/nonEmptyStringArray"}
              },
              "required": [
                "finding_code",
                "affected_component",
                "affected_console_surface",
                "actual_behavior",
                "expected_behavior",
                "reproduction_steps",
                "acceptance_criteria"
              ]
            },
            {
              "properties": {
                "review_disposition": {"const": "DEFER_PILOT_OBJECT"},
                "finding_code": {"type": "string", "pattern": "^PD-DEFER-[A-Z0-9-]+$"}
              },
              "required": ["finding_code", "resolution_criteria", "next_review_condition"]
            },
            {
              "properties": {
                "review_disposition": {"const": "REJECT_PILOT_OBJECT"},
                "finding_code": {"type": "string", "pattern": "^PD-REJECT-[A-Z0-9-]+$"}
              },
              "required": ["finding_code", "structural_basis"]
            }
          ]
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
