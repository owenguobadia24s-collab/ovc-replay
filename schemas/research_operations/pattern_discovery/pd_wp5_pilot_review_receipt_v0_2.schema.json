{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ovc.local/schemas/research_operations/pattern_discovery/pd_wp5_pilot_review_receipt_v0_2.schema.json",
  "title": "PD-WP5 Structured Pilot Review Receipt v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "pilot_run_id",
    "pilot_namespace",
    "operator_id",
    "reviewed_at_utc",
    "decisions",
    "decision_count",
    "source_review_contract",
    "pilot_only",
    "promotion_eligibility",
    "canonical_append",
    "status",
    "signature_algorithm",
    "signature_format",
    "signature_namespace",
    "signed_payload_sha256",
    "signature_sha256",
    "signature"
  ],
  "properties": {
    "schema": {"const": "ovc-pd-wp5-pilot-review-receipt/v2"},
    "pilot_run_id": {"type": "string", "pattern": "^PD\\.PILOT\\.RUN\\.[0-9A-Za-z.-]+$"},
    "pilot_namespace": {"type": "string", "pattern": "^PD\\.PILOT\\."},
    "operator_id": {"const": "OVC.OPERATOR.PRIMARY.LOCAL.V1"},
    "reviewed_at_utc": {"type": "string", "pattern": "Z$"},
    "decisions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object"}},
    "decision_count": {"type": "integer", "minimum": 1},
    "source_review_contract": {"const": "ovc-pd-wp5-pilot-review-input/v2"},
    "pilot_only": {"const": true},
    "promotion_eligibility": {"const": "NON_PROMOTABLE"},
    "canonical_append": {"const": "DENIED"},
    "status": {"const": "OPERATOR_REVIEW_COMPLETE_STRUCTURED_V2"},
    "signature_algorithm": {"const": "ED25519"},
    "signature_format": {"const": "SSHSIG_OPENSSH_V1"},
    "signature_namespace": {"const": "ovc-rps"},
    "signed_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature": {"type": "string", "minLength": 1}
  }
}
