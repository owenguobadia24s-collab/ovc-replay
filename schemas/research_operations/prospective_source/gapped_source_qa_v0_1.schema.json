{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ovc://schemas/research_operations/prospective_source/gapped_source_qa_v0_1",
  "title": "RPS Gapped Source QA v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "slice_id",
    "coverage_state",
    "m1_results",
    "native_h1_results",
    "shared_m1_timestamp_set",
    "repair_performed",
    "qa_state"
  ],
  "properties": {
    "schema": {"const": "ovc-rps-g1b-gap-duplicate-qa/v1"},
    "slice_id": {
      "const": "RPS.DUKASCOPY.GBPUSD.20260622_20260625.v1"
    },
    "coverage_state": {"const": "GAPPED"},
    "m1_results": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "clock",
          "side",
          "row_count",
          "duplicates",
          "non_monotonic",
          "boundary_complete",
          "missing_timestamp_count",
          "missing_timestamps_utc",
          "gap_run_count",
          "gap_runs",
          "coverage_state",
          "repair_performed",
          "qa_state"
        ],
        "properties": {
          "clock": {"const": "M1"},
          "side": {"enum": ["BID", "ASK"]},
          "row_count": {"const": 4285},
          "duplicates": {"const": 0},
          "non_monotonic": {"const": 0},
          "boundary_complete": {"const": true},
          "missing_timestamp_count": {"const": 35},
          "missing_timestamps_utc": {
            "type": "array",
            "minItems": 35,
            "maxItems": 35,
            "items": {"type": "string", "format": "date-time"}
          },
          "gap_run_count": {"const": 24},
          "gap_runs": {
            "type": "array",
            "minItems": 24,
            "maxItems": 24,
            "items": {
              "type": "object",
              "required": [
                "start_utc",
                "end_utc_inclusive",
                "missing_minute_count"
              ],
              "properties": {
                "start_utc": {"type": "string", "format": "date-time"},
                "end_utc_inclusive": {"type": "string", "format": "date-time"},
                "missing_minute_count": {"type": "integer", "minimum": 1}
              }
            }
          },
          "coverage_state": {"const": "GAPPED"},
          "repair_performed": {"const": false},
          "qa_state": {"const": "PASS_GAPPED"}
        }
      }
    },
    "native_h1_results": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["clock", "side", "row_count", "qa_state"],
        "properties": {
          "clock": {"const": "H1"},
          "side": {"enum": ["BID", "ASK"]},
          "row_count": {"const": 72},
          "qa_state": {"const": "PASS"}
        }
      }
    },
    "shared_m1_timestamp_set": {"const": true},
    "repair_performed": {"const": false},
    "qa_state": {"const": "PASS_GAPPED"}
  }
}
