{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ovc://schemas/research_operations/prospective_source/operator_signing_binding_v0_1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "signing_binding_id",
    "operator_id",
    "algorithm",
    "signature_format",
    "signature_namespace",
    "public_key",
    "public_key_sha256",
    "public_key_fingerprint",
    "private_key_in_git",
    "private_key_alias",
    "run_id",
    "binding_id",
    "source_slice_id",
    "private_key_protection_confirmed",
    "active_research_triage",
    "write_authority",
    "status"
  ],
  "properties": {
    "schema": {"const": "ovc-rps-operator-signing-binding/v1"},
    "signing_binding_id": {"type": "string", "pattern": "^RPS\\.SIGNING\\.[0-9a-f]{24}$"},
    "operator_id": {"type": "string", "pattern": "^OVC\\.OPERATOR\\.[A-Z0-9][A-Z0-9_.-]*\\.V[0-9]+$"},
    "algorithm": {"const": "ED25519"},
    "signature_format": {"const": "SSHSIG_OPENSSH_V1"},
    "signature_namespace": {"const": "ovc-rps"},
    "public_key": {"type": "string", "pattern": "^ssh-ed25519 [A-Za-z0-9+/=]+$"},
    "public_key_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "public_key_fingerprint": {"type": "string", "pattern": "^SHA256:"},
    "private_key_in_git": {"const": false},
    "private_key_alias": {"type": "string", "pattern": "^OVC_EXTERNAL_ARTIFACT_ROOT/"},
    "run_id": {"const": "RPS.RUN.7aeb551335d766ee3bf503e6"},
    "binding_id": {"const": "RPS.BINDING.32fb3003efa072916c11e907"},
    "source_slice_id": {"const": "RPS.DUKASCOPY.GBPUSD.20260622_20260625.v1"},
    "private_key_protection_confirmed": {"const": true},
    "active_research_triage": {"const": false},
    "write_authority": {"const": false},
    "status": {"const": "REGISTERED_REPLAY_ONLY_CANDIDATE"}
  }
}
