{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ovc://schemas/research_operations/prospective_source/prospective_compute_receipt_v0_1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "binding_id",
    "slice_id",
    "source_manifest_sha256",
    "output_manifest_sha256",
    "output_manifest_file_sha256",
    "compute_run_file_sha256",
    "binding_file_sha256",
    "code_commit",
    "operation_mode",
    "admissible_cutoff_utc",
    "c1_record_count",
    "c2_state_count",
    "c2_transition_count",
    "deterministic_replay",
    "lineage_complete",
    "provider_network_access_performed",
    "release_status",
    "selector_eligibility",
    "r2_publication",
    "validation_consumption",
    "live_prospective_append",
    "active_research_triage",
    "write_authority",
    "status"
  ],
  "properties": {
    "schema": {"const": "ovc-rps-wp3-compute-receipt/v1"},
    "run_id": {"type": "string", "pattern": "^RPS\\.RUN\\.[0-9a-f]{24}$"},
    "binding_id": {"type": "string", "pattern": "^RPS\\.BINDING\\.[0-9a-f]{24}$"},
    "slice_id": {"const": "RPS.DUKASCOPY.GBPUSD.20260622_20260625.v1"},
    "source_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output_manifest_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "compute_run_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binding_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "code_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "operation_mode": {"const": "TIME_GATED_REPLAY"},
    "admissible_cutoff_utc": {"const": "2026-06-25T00:00:00Z"},
    "c1_record_count": {"type": "integer", "minimum": 1},
    "c2_state_count": {"type": "integer", "minimum": 1},
    "c2_transition_count": {"type": "integer", "minimum": 0},
    "deterministic_replay": {"const": true},
    "lineage_complete": {"const": true},
    "provider_network_access_performed": {"const": false},
    "release_status": {"const": "NOT_A_RELEASE"},
    "selector_eligibility": {"const": "NONE"},
    "r2_publication": {"const": "DENIED"},
    "validation_consumption": {"const": "DENIED"},
    "live_prospective_append": {"const": "DENIED"},
    "active_research_triage": {"const": false},
    "write_authority": {"const": false},
    "status": {"const": "COMPLETE_LOCAL_CANDIDATE"}
  }
}
