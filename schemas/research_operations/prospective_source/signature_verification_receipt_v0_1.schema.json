{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ovc://schemas/research_operations/prospective_source/signature_verification_receipt_v0_1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "acceptance_id",
    "operator_id",
    "signing_binding_id",
    "algorithm",
    "signature_format",
    "signature_namespace",
    "public_key_fingerprint",
    "signed_payload_sha256",
    "signature_sha256",
    "signature_verified",
    "operator_signing_binding_file_sha256",
    "time_gated_replay_acceptance_file_sha256",
    "private_key_in_git",
    "private_key_material_in_receipt",
    "active_research_triage",
    "write_authority",
    "status"
  ],
  "properties": {
    "schema": {"const": "ovc-rps-signature-verification-receipt/v1"},
    "acceptance_id": {"type": "string", "pattern": "^RPS\\.REPLAY-ACCEPT\\.[0-9a-f]{24}$"},
    "operator_id": {"type": "string", "pattern": "^OVC\\.OPERATOR\\.[A-Z0-9][A-Z0-9_.-]*\\.V[0-9]+$"},
    "signing_binding_id": {"type": "string", "pattern": "^RPS\\.SIGNING\\.[0-9a-f]{24}$"},
    "algorithm": {"const": "ED25519"},
    "signature_format": {"const": "SSHSIG_OPENSSH_V1"},
    "signature_namespace": {"const": "ovc-rps"},
    "public_key_fingerprint": {"type": "string", "pattern": "^SHA256:"},
    "signed_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature_verified": {"const": true},
    "operator_signing_binding_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "time_gated_replay_acceptance_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "private_key_in_git": {"const": false},
    "private_key_material_in_receipt": {"const": false},
    "active_research_triage": {"const": false},
    "write_authority": {"const": false},
    "status": {"const": "PASS"}
  }
}
