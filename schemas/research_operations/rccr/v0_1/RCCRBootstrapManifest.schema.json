{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"RCCRBootstrapManifest","type":"object","additionalProperties":false,"required":["schema_version","bootstrap_id","evaluation_cutoff","source_resolution_manifest","admitted_source_classes","included_item_refs","excluded_item_refs","exclusion_reasons","capability_frontier_id","mode_visibility_bindings","QA_receipt","semantic_hash","first_valid_time","authority_effect"],"properties":{"schema_version":{"const":"0.1"},"bootstrap_id":{"type":"string","minLength":1},"evaluation_cutoff":{"type":"string","format":"date-time"},"source_resolution_manifest":{"type":"string","minLength":1},"admitted_source_classes":{"type":"array","items":{"type":"string"}},"included_item_refs":{"type":"array","items":{"type":"string"}},"excluded_item_refs":{"type":"array","items":{"type":"string"}},"exclusion_reasons":{"type":"array","items":{"type":"string"}},"capability_frontier_id":{"type":"string","minLength":1},"mode_visibility_bindings":{"type":"array","items":{"type":"object"}},"QA_receipt":{"type":"string","minLength":1},"semantic_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"first_valid_time":{"type":"string","format":"date-time"},"authority_effect":{"const":"NONE"}}}