{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"ResearchCoverageAssessment","type":"object","additionalProperties":false,"required":["schema_version","coverage_assessment_id","coverage_item_generation_id","requirement_profile_id","capability_frontier_id","assessment_rule_pack_id","evaluation_cutoff","answerability_state","coverage_status","requirement_results","gap_assessments","counterfactual_sufficiency_review","lawful_next_route","earliest_lawful_research_stage","blocking_conditions","evidence_refs","QA_state","first_valid_time","authority_effect"],"properties":{"schema_version":{"const":"0.1"},"coverage_assessment_id":{"type":"string","minLength":1},"coverage_item_generation_id":{"type":"string","minLength":1},"requirement_profile_id":{"type":"string","minLength":1},"capability_frontier_id":{"type":"string","minLength":1},"assessment_rule_pack_id":{"type":"string","minLength":1},"evaluation_cutoff":{"type":"string","format":"date-time"},"answerability_state":{"enum":["FULLY_ANSWERABLE","PARTIALLY_ANSWERABLE","NOT_ANSWERABLE_CURRENT_FRONTIER","INVALID_QUESTION_CURRENT_PROTOCOL","OUT_OF_SCOPE_CURRENT_PROTOCOL","UNRESOLVED"]},"coverage_status":{"enum":["FULL","PARTIAL","NONE","UNRESOLVED","NOT_APPLICABLE"]},"requirement_results":{"type":"array","items":{"type":"object"}},"gap_assessments":{"type":"array","items":{"type":"object"}},"counterfactual_sufficiency_review":{"type":"object"},"lawful_next_route":{"type":"string"},"earliest_lawful_research_stage":{"type":"string"},"blocking_conditions":{"type":"array","items":{"type":"string"}},"evidence_refs":{"type":"array","items":{"type":"string"}},"QA_state":{"enum":["PASS","WARN","BLOCK","QUARANTINE"]},"first_valid_time":{"type":"string","format":"date-time"},"supersedes_assessment_id":{"type":["string","null"]},"authority_effect":{"const":"NONE"}}}