{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ovc://schemas/research_operations/spto/C2_OWNER_STREAM_BINDING_v0_1.schema.json",
  "title": "C2OwnerStreamBinding v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "c2_owner_stream_binding_id", "programme_id", "protocol_id", "owner_resolution_id", "owner_authority_id", "read_authority_id", "owner_generation_id", "owner_snapshot_schema", "source_binding", "population_mode", "snapshot_ids", "chronology", "population_accounting", "record_policy", "break_policy", "missingness_policy", "candidate_generation", "protected_source_access", "validation", "forbidden_dependency_reachability"],
  "properties": {
    "schema": {"const": "ovc-c2s-sptoi-c2-owner-stream-binding/v0.1"},
    "c2_owner_stream_binding_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "programme_id": {"const": "OVC-EML-C2S-SPTO-CONFORMANCE-PREREG-v0.1"},
    "protocol_id": {"const": "OVC-EML-GRAMMAR-0002-RP-0.1-R1"},
    "owner_resolution_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "owner_authority_id": {"const": "AUTH.OPT-B.C2.vNext.ACTIVE.RUNTIME.v0.1"},
    "read_authority_id": {"const": "AUTH.OPT-B.C2.vNext.OWNER_STRUCTURAL_SNAPSHOT.READ.v0.1"},
    "owner_generation_id": {"const": "C2VNEXT.OWNER.GENERATION.ASR00.C2AR-PACKAGE-v1.READ-v0.1"},
    "owner_snapshot_schema": {"const": "ovc-c2-vnext-owner-structural-snapshot-read/v0.1"},
    "source_binding": {"type": "object"},
    "population_mode": {"enum": ["SYNTHETIC_QUALIFICATION_FIXTURE", "CONSUMED_DATA_CONFORMANCE"]},
    "snapshot_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "chronology": {"type": "object"},
    "population_accounting": {"type": "object"},
    "record_policy": {"const": "EXACT_OWNER_RECORDS_PRESERVED_NO_FLATTENING_NO_REPAIR"},
    "break_policy": {"const": "OWNER_TYPED_BREAKS_PRESERVED_AND_CROSS_BREAK_JOIN_DENIED"},
    "missingness_policy": {"const": "OWNER_TYPED_ABSENCE_PRESERVED_NO_NEUTRAL_IMPUTATION"},
    "candidate_generation": {"const": "DENIED"},
    "protected_source_access": {"const": "NONE"},
    "validation": {"const": "LOCKED_UNCONSUMED"},
    "forbidden_dependency_reachability": {"const": "NONE"}
  }
}
