{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ovc.local/schemas/research_operations/spto/PRE_GREAL_OPERATOR_PACKET_v0_1.schema.json",
  "title": "C2S-SPTOI pre-GREAL operator packet",
  "type": "object",
  "required": [
    "schema",
    "programme_id",
    "packet_id",
    "gate_id",
    "gate_class",
    "status",
    "governing_authority",
    "source_and_read_surface",
    "tvx_source_and_reproduction",
    "population_and_training",
    "factorised_mechanics",
    "null_coupling",
    "opportunity_exposure_and_freshness",
    "derivation_capacity_and_retention",
    "reviewer_independence",
    "laboratory_custody",
    "qa_and_file_bindings",
    "warnings",
    "unresolved_issues",
    "proposed_real_source_authority_delta",
    "rollback",
    "current_authority",
    "decision",
    "next_lawful_action",
    "operator_packet_id"
  ],
  "properties": {
    "schema": {"const": "ovc-c2s-sptoi-pre-greal-operator-packet/v0.1"},
    "programme_id": {"const": "OVC-EML-C2S-SPTO-CONFORMANCE-PREREG-v0.1"},
    "packet_id": {"const": "C2S-SPTOI-WP11"},
    "gate_id": {"const": "C2S-SPTOI-GREAL-SCI-PREREG"},
    "gate_class": {"const": "OPERATOR_REQUIRED"},
    "status": {"const": "GREAL_PACKET_READY"},
    "decision": {"const": "UNDECIDED_OPERATOR_REQUIRED"},
    "next_lawful_action": {"const": "PRESENT_THIS_EXACT_PACKET_TO_OPERATOR_AND_STOP"},
    "operator_packet_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "governing_authority": {"type": "object"},
    "source_and_read_surface": {"type": "object"},
    "tvx_source_and_reproduction": {"type": "object"},
    "population_and_training": {"type": "object"},
    "factorised_mechanics": {"type": "object"},
    "null_coupling": {"type": "object"},
    "opportunity_exposure_and_freshness": {"type": "object"},
    "derivation_capacity_and_retention": {"type": "object"},
    "reviewer_independence": {"type": "object"},
    "laboratory_custody": {"type": "array", "minItems": 6, "maxItems": 6},
    "qa_and_file_bindings": {"type": "object"},
    "warnings": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "unresolved_issues": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "proposed_real_source_authority_delta": {"type": "object"},
    "rollback": {"type": "string"},
    "current_authority": {"type": "object"}
  },
  "additionalProperties": true
}
