{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ovc.invalid/research_operations/spto/RICH_ALGORITHMIC_ASSURANCE_RECEIPT_v0_1.schema.json",
  "title": "C2S-SPTOI Rich Algorithmic Assurance Receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "assurance_version", "programme_id", "packet_id", "gate_id", "protocol_sha256", "wp6_registry_id", "wp6_fixture_bundle_id", "checks", "check_count", "result", "fresh_process_requirement", "protected_source_access", "factorised_evidence_execution", "authority_effect", "receipt_id"],
  "properties": {
    "schema": {"const": "ovc-c2s-sptoi-rich-algorithmic-assurance-receipt/v0.1"},
    "assurance_version": {"const": "C2S-SPTOI-WP7-INDEPENDENT-ALGORITHMIC-ASSURANCE-v1"},
    "programme_id": {"const": "OVC-EML-C2S-SPTO-CONFORMANCE-PREREG-v0.1"},
    "packet_id": {"const": "C2S-SPTOI-WP7"},
    "gate_id": {"const": "C2S-SPTOI-G7-RICH-ALG"},
    "protocol_sha256": {"const": "a4eaaa43d051628e6fc6da4151ed9500f68a832d85240188cdf0f656a1893fd5"},
    "wp6_registry_id": {"$ref": "#/$defs/sha256"},
    "wp6_fixture_bundle_id": {"$ref": "#/$defs/sha256"},
    "checks": {
      "type": "array", "minItems": 14, "maxItems": 14,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["check_id", "assertion", "result", "evidence"],
        "properties": {
          "check_id": {"type": "string", "pattern": "^WP7-ALG-[0-9]{2}$"},
          "assertion": {"type": "string", "minLength": 1},
          "result": {"const": "PASS"},
          "evidence": {}
        }
      }
    },
    "check_count": {"const": 14},
    "result": {"const": "PASS_SOURCE_FREE_ALGORITHMIC_ASSURANCE"},
    "fresh_process_requirement": {"const": "VERIFIED_BY_RUNNER_REEXECUTION_TEST"},
    "protected_source_access": {"const": "NONE"},
    "factorised_evidence_execution": {"const": "DENIED"},
    "authority_effect": {"const": "NONE_ALGORITHMIC_ASSURANCE_ONLY"},
    "receipt_id": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
