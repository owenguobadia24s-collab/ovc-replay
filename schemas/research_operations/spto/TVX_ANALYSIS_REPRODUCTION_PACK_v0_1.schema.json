{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvariancecontrol.local/schemas/research_operations/spto/TVX_ANALYSIS_REPRODUCTION_PACK_v0_1.schema.json",
  "title": "TVX analysis reproduction pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "reproduction_pack_id", "programme_id", "packet_id", "execution_status", "source_completeness", "missing_prerequisites", "executed_analyses", "outputs", "interpretation", "authority_effect"],
  "properties": {
    "schema": {"const": "ovc-tvx-analysis-reproduction-pack/v0.1"},
    "reproduction_pack_id": {"type": "string", "minLength": 1},
    "programme_id": {"const": "OVC-EML-C2S-SPTO-CONFORMANCE-PREREG-v0.1"},
    "packet_id": {"const": "C2S-SPTOI-WP5"},
    "execution_status": {"const": "NOT_EXECUTED_SOURCE_INCOMPLETE"},
    "source_completeness": {"const": "PARTIAL_SOURCE_LIMITED"},
    "missing_prerequisites": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "executed_analyses": {"const": []},
    "outputs": {"const": []},
    "interpretation": {"const": "NOT_A_REPRODUCTION_FAILURE_OR_MISMATCH"},
    "future_execution_preconditions": {"type": "array", "items": {"type": "string"}},
    "authority_effect": {"const": "NONE_EXECUTION_WITHHELD_FAIL_CLOSED"}
  }
}
