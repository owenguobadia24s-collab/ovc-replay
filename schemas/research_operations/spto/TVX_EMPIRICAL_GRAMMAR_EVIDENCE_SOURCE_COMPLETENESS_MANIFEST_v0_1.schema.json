{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvariancecontrol.local/schemas/research_operations/spto/TVX_EMPIRICAL_GRAMMAR_EVIDENCE_SOURCE_COMPLETENESS_MANIFEST_v0_1.schema.json",
  "title": "TVX empirical grammar evidence source completeness manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "manifest_id", "programme_id", "packet_id", "status", "required_rounds", "sources", "source_policy", "authority_effect"],
  "properties": {
    "schema": {"const": "ovc-tvx-empirical-grammar-evidence-source-completeness-manifest/v0.1"},
    "manifest_id": {"type": "string", "minLength": 1},
    "programme_id": {"const": "OVC-EML-C2S-SPTO-CONFORMANCE-PREREG-v0.1"},
    "packet_id": {"const": "C2S-SPTOI-WP5"},
    "status": {"const": "PARTIAL_SOURCE_LIMITED"},
    "required_rounds": {
      "type": "array", "minItems": 13, "maxItems": 13, "uniqueItems": true,
      "items": {"enum": ["R9X", "R16", "R21", "R22", "R23", "R24", "R25", "R26", "R27", "R28", "R29", "R30", "R31"]}
    },
    "sources": {
      "type": "array", "minItems": 13,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["round_id", "required_role", "historical_passport", "current_exact_source", "disposition"],
        "properties": {
          "round_id": {"type": "string"},
          "required_role": {"type": "string"},
          "expected_filename": {"type": ["string", "null"]},
          "expected_sha256": {"anyOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]},
          "historical_passport": {"type": "string"},
          "current_exact_source": {"enum": ["PRESENT_BOUND", "ABSENT", "INCOMPLETE_RECOVERY_ONLY"]},
          "disposition": {"enum": ["ADMITTED_EXACT", "RECEIPT_ONLY_NOT_REPRODUCIBLE", "NOT_ADMITTED_RECOVERY_ONLY", "MISSING"]},
          "notes": {"type": "string"}
        }
      }
    },
    "source_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["prose_may_define_missing_mechanics", "reconstruction_admissible", "protected_source_access", "validation"],
      "properties": {
        "prose_may_define_missing_mechanics": {"const": false},
        "reconstruction_admissible": {"const": false},
        "protected_source_access": {"const": "NONE"},
        "validation": {"const": "LOCKED_UNCONSUMED"}
      }
    },
    "authority_effect": {"const": "SOURCE_CLASSIFICATION_ONLY_NO_MECHANICS_OR_SCIENTIFIC_PROMOTION"}
  }
}
