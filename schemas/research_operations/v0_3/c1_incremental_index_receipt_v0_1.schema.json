{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ovc-ro3-c1-incremental-index-receipt/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "prior_logical_index_sha256", "added_source_identities", "final_logical_index_sha256", "equivalence_requirement", "writes", "receipt_id"],
  "properties": {
    "schema": {"const": "ovc-ro3-c1-incremental-index-receipt/v1"},
    "prior_logical_index_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "added_source_identities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "final_logical_index_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "equivalence_requirement": {"const": "FINAL_HASH_MUST_EQUAL_FULL_REBUILD"},
    "writes": {"const": "NONE"},
    "receipt_id": {"type": "string", "pattern": "^RO3-C1-INCR-[0-9a-f]{20}$"}
  }
}
