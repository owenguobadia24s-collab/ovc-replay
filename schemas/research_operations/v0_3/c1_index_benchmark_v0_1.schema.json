{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ovc-ro3-c1-index-benchmark/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "benchmark_id", "machine", "python_version", "operating_system", "corpus_type", "record_count", "record_file_count", "formula_count", "wall_time_seconds", "peak_memory_bytes", "records_per_second", "soft_target_seconds", "soft_target_result", "logical_index_sha256", "reproducibility", "writes"],
  "properties": {
    "schema": {"const": "ovc-ro3-c1-index-benchmark/v1"},
    "benchmark_id": {"type": "string", "pattern": "^RO3-C1-BENCH-[0-9a-f]{20}$"},
    "machine": {"type": "string", "minLength": 1},
    "python_version": {"type": "string", "minLength": 1},
    "operating_system": {"type": "string", "minLength": 1},
    "corpus_type": {"enum": ["EXACT_RELEASE_RECORD_HEADERS", "DECLARED_FULL_CORPUS_SHAPE"]},
    "record_count": {"const": 212764},
    "record_file_count": {"const": 192},
    "formula_count": {"const": 18},
    "wall_time_seconds": {"type": "number", "minimum": 0},
    "peak_memory_bytes": {"type": "integer", "minimum": 0},
    "records_per_second": {"type": "number", "exclusiveMinimum": 0},
    "soft_target_seconds": {"const": 300},
    "soft_target_result": {"enum": ["PASS", "INCREMENTAL_FALLBACK_REQUIRED"]},
    "logical_index_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reproducibility": {"enum": ["PASS_IDENTICAL_RERUN", "NOT_EVALUATED"]},
    "writes": {"const": "NONE"}
  }
}
