{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ovc-ro3-c1-release-index/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["release_index_id", "role", "release_id", "manifest_sha256", "instrument", "coverage_start", "coverage_end", "record_count", "record_file_count", "schema_version", "formula_registry_id", "formula_registry_sha256", "clocks", "sides", "selector_state", "lifecycle_state", "availability", "eligible_source_bar_count", "source_rejections", "writes"],
  "properties": {
    "release_index_id": {"type": "string", "pattern": "^RO3-C1-REL-[0-9a-f]{20}$"},
    "role": {"enum": ["DISCOVERY", "DEVELOPMENT"]},
    "release_id": {"type": "string", "minLength": 1},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "instrument": {"const": "GBPUSD"},
    "coverage_start": {"type": "string"},
    "coverage_end": {"type": "string"},
    "record_count": {"type": "integer", "minimum": 1},
    "record_file_count": {"type": "integer", "minimum": 1},
    "schema_version": {"type": "string"},
    "formula_registry_id": {"const": "C1.FORMULAS.v0.1"},
    "formula_registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "clocks": {"type": "array", "items": {"enum": ["15M", "2H_A_L"]}, "minItems": 2, "maxItems": 2, "uniqueItems": true},
    "sides": {"type": "array", "items": {"enum": ["BID", "ASK"]}, "minItems": 2, "maxItems": 2, "uniqueItems": true},
    "selector_state": {"const": "SHADOW"},
    "lifecycle_state": {"type": "string"},
    "availability": {"const": "REMOTE_VERIFIED"},
    "eligible_source_bar_count": {"type": "integer", "minimum": 0},
    "source_rejections": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "writes": {"const": "NONE"}
  }
}
