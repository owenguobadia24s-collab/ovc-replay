{
  "$id": "ovc-ro4-neutral-recurrence-candidate/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "not": {
    "anyOf": [
      {
        "required": [
          "pd_candidate_id"
        ]
      },
      {
        "required": [
          "family_id"
        ]
      },
      {
        "required": [
          "promotion_status"
        ]
      },
      {
        "required": [
          "probability"
        ]
      }
    ]
  },
  "properties": {
    "authority": {
      "const": "NON_CANONICAL_RESEARCH_CANDIDATE"
    },
    "boundary_stability": {
      "type": "object"
    },
    "candidate_id": {
      "pattern": "^RO4\\.RECURRENCE\\.",
      "type": "string"
    },
    "counterexample_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "exact_or_declared_distance": {
      "type": [
        "object",
        "null"
      ]
    },
    "matched_control_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "member_sequence_ids": {
      "items": {
        "pattern": "^RO4\\.SEQUENCE\\.",
        "type": "string"
      },
      "minItems": 2,
      "type": "array"
    },
    "no_counterexample_reason": {
      "enum": [
        "NO_COUNTEREXAMPLE_AVAILABLE"
      ]
    },
    "operation_modes": {
      "items": {
        "enum": [
          "LIVE_PROSPECTIVE",
          "TIME_GATED_REPLAY",
          "NON_EVIDENTIARY_REPLAY"
        ]
      },
      "type": "array"
    },
    "population_control_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "semantic_label": {
      "const": "PROHIBITED"
    },
    "sequence_policy_id": {
      "type": "string"
    },
    "signature_type": {
      "enum": [
        "EXACT",
        "DECLARED_DISTANCE"
      ]
    },
    "source_release_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "support_counts": {
      "items": {
        "$ref": "count_denominator_cell_v0_1.schema.json"
      },
      "type": "array"
    }
  },
  "required": [
    "candidate_id",
    "source_release_ids",
    "sequence_policy_id",
    "signature_type",
    "member_sequence_ids",
    "support_counts",
    "matched_control_ids",
    "population_control_ids",
    "counterexample_ids",
    "operation_modes",
    "authority",
    "semantic_label"
  ],
  "title": "ovc-ro4-neutral-recurrence-candidate/v1",
  "type": "object"
}
