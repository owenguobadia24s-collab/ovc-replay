{
  "$id": "ovc-ro4-sequence-signature/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "not": {
    "anyOf": [
      {
        "required": [
          "learned_weight"
        ]
      },
      {
        "required": [
          "family_name"
        ]
      },
      {
        "required": [
          "archetype"
        ]
      },
      {
        "required": [
          "prediction"
        ]
      },
      {
        "required": [
          "promotion"
        ]
      }
    ]
  },
  "properties": {
    "authority": {
      "const": "NON_CANONICAL_SEQUENCE_EVIDENCE"
    },
    "canonical_json_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "context_markers": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "distance_components": {
      "type": "object"
    },
    "distance_registry_id": {
      "const": "RO4.SEQUENCE.DISTANCE.v0.1"
    },
    "duration_bins": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "ordered_axis_vectors": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "ordered_changed_axis_sets": {
      "items": {
        "items": {
          "enum": [
            "LOCATION",
            "MOTION",
            "ORGANISATION",
            "INTERACTION",
            "QUALITY"
          ]
        },
        "type": "array"
      },
      "type": "array"
    },
    "raw_durations": {
      "items": {
        "minimum": 1,
        "type": "integer"
      },
      "type": "array"
    },
    "registry_versions": {
      "type": "object"
    },
    "sequence_id": {
      "pattern": "^RO4\\.SEQUENCE\\.",
      "type": "string"
    },
    "signature_id": {
      "type": "string"
    },
    "signature_type": {
      "enum": [
        "EXACT",
        "DECLARED_DISTANCE"
      ]
    }
  },
  "required": [
    "signature_id",
    "sequence_id",
    "signature_type",
    "ordered_axis_vectors",
    "ordered_changed_axis_sets",
    "registry_versions",
    "canonical_json_sha256",
    "authority"
  ],
  "title": "ovc-ro4-sequence-signature/v1",
  "type": "object"
}
