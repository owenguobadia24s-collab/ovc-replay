{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ovc://shared-systems/evidence-state-interface/v0.1",
  "title": "Shared Systems WP2 envelope union",
  "oneOf": [
    {"$ref": "#/$defs/EvidenceFrontier"},
    {"$ref": "#/$defs/DependencyDescriptor"},
    {"$ref": "#/$defs/StatePlaneValue"},
    {"$ref": "#/$defs/LineageEdgeEnvelope"},
    {"$ref": "#/$defs/CompatibilityContract"},
    {"$ref": "#/$defs/AdapterDescriptor"},
    {"$ref": "#/$defs/InterfaceBinding"}
  ],
  "$defs": {
    "Ref": {"type":"string","minLength":1,"not":{"pattern":"(?i)latest"}},
    "StatePlaneValue": {"type":"object","additionalProperties":false,"required":["plane_family","owner_namespace","owner_state","authority_effect"],"properties":{"plane_family":{"enum":["LIFECYCLE","AVAILABILITY","OBSERVABILITY","EVALUABILITY","COMPARABILITY","EXECUTION","AUTHORITY","MATURITY","PROGRESSION","ASSURANCE","REPRODUCIBILITY"]},"owner_namespace":{"type":"string","minLength":1},"owner_state":{"type":"string","minLength":1},"owning_rule_ref":{"type":["string","null"]},"authority_effect":{"const":"NONE"}}},
    "DependencyDescriptor": {"type":"object","additionalProperties":false,"required":["source_requirement","requiredness","consumption_policy","purpose","owner_role","failure_disposition","source_owner","dependent_surfaces"],"properties":{"source_requirement":{"type":"string","minLength":1},"requiredness":{"enum":["REQUIRED","OPTIONAL","CONDITIONAL"]},"consumption_policy":{"enum":["ALLOWED","FORBIDDEN"]},"purpose":{"type":"string","minLength":1},"owner_role":{"type":"string","minLength":1},"failure_disposition":{"type":"string","minLength":1},"source_owner":{"type":"string","minLength":1},"dependent_surfaces":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"authority_requirement":{"type":["string","null"]},"comparability_requirement":{"type":["string","null"]}}},
    "EvidenceEntry": {"type":"object","additionalProperties":false,"required":["evidence_id","dependency_ref","first_valid_time","source_generation"],"properties":{"evidence_id":{"type":"string","minLength":1},"dependency_ref":{"type":"string","minLength":1},"first_valid_time":{"type":"string","format":"date-time"},"source_generation":{"type":"string","minLength":1}}},
    "EvidenceFrontier": {"type":"object","additionalProperties":false,"required":["frontier_id","schema_version","owner_namespace","evaluation_cutoff","dependency_manifest_ref","evidence_entries","missing_entries","latest_required_first_valid_time","source_generations","reason_codes"],"properties":{"frontier_id":{"type":"string","minLength":1},"schema_version":{"const":"0.1"},"owner_namespace":{"type":"string","minLength":1},"evaluation_cutoff":{"type":"string","format":"date-time"},"dependency_manifest_ref":{"$ref":"#/$defs/Ref"},"evidence_entries":{"type":"array","items":{"$ref":"#/$defs/EvidenceEntry"}},"missing_entries":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"latest_required_first_valid_time":{"type":["string","null"],"format":"date-time"},"source_generations":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"comparability_domain_ref":{"type":["string","null"]},"authority_snapshot_ref":{"type":["string","null"]},"reason_codes":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}}},
    "LineageEdgeEnvelope": {"type":"object","additionalProperties":false,"required":["edge_id","lineage_plane","predicate_owner","predicate","source_ref","target_ref","semantic_scope","extension_type"],"properties":{"edge_id":{"type":"string","minLength":1},"lineage_plane":{"enum":["DERIVATION","GENEALOGY","CORRESPONDENCE","SUPERSESSION_VERSION","RESEARCH_EVIDENCE","REPOSITORY_GOVERNANCE","DEPENDENCY_IMPACT"]},"predicate_owner":{"type":"string","minLength":1},"predicate":{"type":"string","minLength":1,"not":{"const":"PARENT"}},"source_ref":{"$ref":"#/$defs/Ref"},"target_ref":{"$ref":"#/$defs/Ref"},"semantic_scope":{"type":"string","minLength":1},"extension_type":{"type":"string","minLength":1}}},
    "CompatibilityContract": {"type":"object","additionalProperties":false,"required":["compatibility_contract_id","producer_contract_ref","consumer_contract_ref","compatibility_class","semantic_scope","constraints","declared_loss_fields"],"properties":{"compatibility_contract_id":{"type":"string","minLength":1},"producer_contract_ref":{"$ref":"#/$defs/Ref"},"consumer_contract_ref":{"$ref":"#/$defs/Ref"},"compatibility_class":{"enum":["IDENTICAL","BACKWARD_COMPATIBLE","FORWARD_COMPATIBLE","BIDIRECTIONAL_COMPATIBLE","ADAPTER_REQUIRED","LOSSY_ADAPTER_ALLOWED","HISTORICAL_REPLAY_ONLY","INCOMPATIBLE","UNKNOWN"]},"semantic_scope":{"type":"string","minLength":1},"constraints":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"declared_loss_fields":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}}},
    "AdapterDescriptor": {"type":"object","additionalProperties":false,"required":["adapter_id","adapter_owner","source_contract_ref","target_contract_ref","field_mapping","declared_loss_fields","semantic_inventions"],"properties":{"adapter_id":{"type":"string","minLength":1},"adapter_owner":{"type":"string","minLength":1},"source_contract_ref":{"$ref":"#/$defs/Ref"},"target_contract_ref":{"$ref":"#/$defs/Ref"},"field_mapping":{"type":"array","items":{"type":"array","prefixItems":[{"type":"string","minLength":1},{"type":"string","minLength":1}],"items":false}},"declared_loss_fields":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"semantic_inventions":{"type":"array","maxItems":0}}},
    "InterfaceBinding": {"type":"object","additionalProperties":false,"required":["interface_binding_id","producer_owner","consumer_owner","producer_contract_ref","consumer_contract_ref","schema_refs","serialization_profile_refs","generation_constraints","dependency_role","compatibility_policy_ref"],"properties":{"interface_binding_id":{"type":"string","minLength":1},"producer_owner":{"type":"string","minLength":1},"consumer_owner":{"type":"string","minLength":1},"producer_contract_ref":{"$ref":"#/$defs/Ref"},"consumer_contract_ref":{"$ref":"#/$defs/Ref"},"schema_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/Ref"}},"serialization_profile_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/Ref"}},"generation_constraints":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"dependency_role":{"type":"string","minLength":1},"compatibility_policy_ref":{"$ref":"#/$defs/Ref"},"adapter_ref":{"type":["string","null"]},"qa_refs":{"type":"array","items":{"type":"string"}},"decision_refs":{"type":"array","items":{"type":"string"}},"authority_requirement":{"type":["string","null"]}}}
  }
}
