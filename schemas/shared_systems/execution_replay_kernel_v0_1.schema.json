{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"ovc://shared-systems/execution-replay-kernel/v0.1",
  "title":"Shared Systems WP3 execution object union",
  "oneOf":[{"$ref":"#/$defs/SemanticGenerationRef"},{"$ref":"#/$defs/RunSpecification"},{"$ref":"#/$defs/ExecutionEnvironmentManifest"},{"$ref":"#/$defs/RunExecutionManifest"},{"$ref":"#/$defs/LogicalResultIdentity"},{"$ref":"#/$defs/ReplayResultManifest"},{"$ref":"#/$defs/CheckpointReceipt"},{"$ref":"#/$defs/CapacityReceipt"}],
  "$defs":{
    "Ref":{"type":"string","minLength":1,"not":{"pattern":"(?i)latest"}},
    "SemanticGenerationRef":{"type":"object","additionalProperties":false,"required":["owner_namespace","generation_id","contract_refs"],"properties":{"owner_namespace":{"$ref":"#/$defs/Ref"},"generation_id":{"$ref":"#/$defs/Ref"},"contract_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/Ref"}}}},
    "RunSpecification":{"type":"object","additionalProperties":false,"required":["semantic_generation_ref","population_ids","scope_ref","evaluation_cutoff","parameters","output_contract_ref","logical_barriers"],"properties":{"semantic_generation_ref":{"$ref":"#/$defs/Ref"},"population_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"scope_ref":{"$ref":"#/$defs/Ref"},"evaluation_cutoff":{"type":"string","format":"date-time"},"parameters":{"type":"object"},"output_contract_ref":{"$ref":"#/$defs/Ref"},"logical_barriers":{"type":"array","items":{"type":"string","pattern":"^SOURCE:"}}}},
    "ExecutionEnvironmentManifest":{"type":"object","additionalProperties":false,"required":["environment_id","os","architecture","runtime","toolchain_lock_ref","reproducibility_class"],"properties":{"environment_id":{"$ref":"#/$defs/Ref"},"os":{"type":"string"},"architecture":{"type":"string"},"runtime":{"type":"string"},"toolchain_lock_ref":{"$ref":"#/$defs/Ref"},"reproducibility_class":{"type":"string"}}},
    "RunExecutionManifest":{"type":"object","additionalProperties":false,"required":["run_specification_id","environment_id","attempt_id","worker_count","chunk_size","backend","host_path"],"properties":{"run_specification_id":{"$ref":"#/$defs/Ref"},"environment_id":{"$ref":"#/$defs/Ref"},"attempt_id":{"$ref":"#/$defs/Ref"},"worker_count":{"type":"integer","minimum":1},"chunk_size":{"type":"integer","minimum":1},"backend":{"type":"string","minLength":1},"host_path":{"type":"string"}}},
    "LogicalResultIdentity":{"type":"object","additionalProperties":false,"required":["run_specification_id","ordered_result_hashes"],"properties":{"run_specification_id":{"$ref":"#/$defs/Ref"},"ordered_result_hashes":{"type":"array","items":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}},
    "CheckpointReceipt":{"type":"object","additionalProperties":false,"required":["run_specification_id","next_index","committed_results","prefix_hash"],"properties":{"run_specification_id":{"$ref":"#/$defs/Ref"},"next_index":{"type":"integer","minimum":0},"committed_results":{"type":"array"},"prefix_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},
    "CapacityReceipt":{"type":"object","additionalProperties":false,"required":["run_specification_id","status","required_units","available_units","population_preserved","precision_preserved","sampling_applied"],"properties":{"run_specification_id":{"$ref":"#/$defs/Ref"},"status":{"enum":["READY","CAPACITY_EXCEEDED"]},"required_units":{"type":"integer","minimum":0},"available_units":{"type":"integer","minimum":0},"population_preserved":{"const":true},"precision_preserved":{"const":true},"sampling_applied":{"const":false}}},
    "ReplayResultManifest":{"type":"object","additionalProperties":false,"required":["run_specification_id","logical_result_identity","status","ordered_results","checkpoint","capacity_receipt","authority_effect"],"properties":{"run_specification_id":{"$ref":"#/$defs/Ref"},"logical_result_identity":{"type":["string","null"]},"status":{"enum":["COMPLETE","CHECKPOINTED_BEFORE_COMMIT","CHECKPOINTED_AFTER_COMMIT","CAPACITY_EXCEEDED"]},"ordered_results":{"type":"array"},"checkpoint":{"oneOf":[{"$ref":"#/$defs/CheckpointReceipt"},{"type":"null"}]},"capacity_receipt":{"$ref":"#/$defs/CapacityReceipt"},"authority_effect":{"const":"NONE"}}}
  }
}
