    "owner_namespace": {"type": "string", "minLength": 1},
    "included_fields": {"$ref": "#/$defs/uniqueStrings"},
    "excluded_fields": {"$ref": "#/$defs/uniqueStrings"},
    "conditional_fields": {"$ref": "#/$defs/uniqueStrings"},
    "self_id_fields": {"$ref": "#/$defs/uniqueStrings"},
    "descriptive_only_fields": {"$ref": "#/$defs/uniqueStrings"},
    "projection_version": {"type": "string", "minLength": 1}
  },
  "$defs": {
