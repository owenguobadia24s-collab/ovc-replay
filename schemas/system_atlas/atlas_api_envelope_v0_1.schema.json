{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ovc.local/schemas/system_atlas/atlas_api_envelope_v0_1.schema.json",
  "title": "Atlas API Envelope v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "graph_generation", "repository_tree", "query_policy_version", "completeness_profile", "security_visibility", "warnings", "write_effect", "data"],
  "properties": {
    "schema": {"const": "ovc-atlas-api-envelope/v1"},
    "graph_generation": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repository_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "query_policy_version": {"type": "string", "minLength": 1},
    "completeness_profile": {"type": "string", "minLength": 1},
    "security_visibility": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["ATLAS_PUBLIC_METADATA", "ATLAS_INTERNAL", "ATLAS_RESTRICTED"]}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "write_effect": {"const": "NONE"},
    "data": {}
  }
}
