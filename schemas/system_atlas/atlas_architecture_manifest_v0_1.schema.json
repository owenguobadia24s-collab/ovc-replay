{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ovc.local/schemas/system_atlas/atlas_architecture_manifest_v0_1.schema.json",
  "title": "Atlas Architecture Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "manifest_id", "version", "source_bindings", "declarations", "authority_effect"],
  "properties": {
    "schema": {"const": "ovc-atlas-architecture-manifest/v1"},
    "manifest_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "source_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source_binding"}},
    "declarations": {"type": "array", "items": {"$ref": "#/$defs/declaration"}},
    "authority_effect": {"const": "NONE_SOURCE_BOUND_DESIGN_INDEX_ONLY"}
  },
  "$defs": {
    "source_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "hash_algorithm", "expected_hash", "role"],
      "properties": {
        "locator": {"type": "string", "minLength": 1},
        "hash_algorithm": {"enum": ["sha1", "sha256"]},
        "expected_hash": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
        "role": {"type": "string", "minLength": 1}
      }
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "predicate", "object", "scope_hints"],
      "properties": {
        "subject": {"type": "string", "minLength": 1},
        "predicate": {"type": "string", "minLength": 1},
        "object": {},
        "scope_hints": {"type": "object"}
      }
    }
  }
}
