{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ovc.local/schemas/system_atlas/atlas_query_result_v0_1.schema.json",
  "title": "Atlas Query Result v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "family", "query", "graph_root_hash", "repository_tree", "query_policy_version", "completeness_profile", "visibility_projection", "status", "exhaustive", "warnings", "result", "authority_effect", "result_hash"],
  "properties": {
    "schema": {"const": "ovc-atlas-query-result/v1"},
    "family": {"enum": ["SEARCH", "TRACE", "DEPENDENCY", "IMPACT", "EXPLAIN", "AUTHORITY", "OWNERSHIP", "WHY_BLOCKED", "HISTORY", "DIFF"]},
    "query": {"type": "object"},
    "graph_root_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repository_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "query_policy_version": {"type": "string", "minLength": 1},
    "completeness_profile": {"type": "string", "minLength": 1},
    "visibility_projection": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["ATLAS_PUBLIC_METADATA", "ATLAS_INTERNAL", "ATLAS_RESTRICTED"]}},
    "status": {"enum": ["PASS", "INCOMPLETE_CAPACITY"]},
    "exhaustive": {"type": "boolean"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "result": {"type": "object"},
    "authority_effect": {"const": "NONE_READ_ONLY_QUERY"},
    "result_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
